<Window x:Class="MyNetworkMonitor.ManageIPGroups"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Manage IP Groups" Height="576" Width="1694">

    <!--
        View ist bewusst "dumm": keine Logik im Code-behind. Alle Daten/Befehle
        kommen aus MyNetworkMonitor.Core.ViewModels.ManageIPGroupsViewModel.
        Genau dieses Binding-Muster lässt sich später 1:1 in eine Avalonia-View
        übertragen (nur XAML-Namespace + DataGrid-Dialekt unterscheiden sich).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="87"/>
            <RowDefinition Height="38*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dg_IPGroups"
                  Grid.Row="1"
                  Margin="10"
                  ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Sorting="dg_IPGroups_Sorting"
                  IsReadOnly="False"
                  HeadersVisibility="All"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="is active" Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Group Description" Binding="{Binding IpGroupDescription}" Width="200"/>
                <DataGridTextColumn Header="Device Description" Binding="{Binding DeviceDescription}" Width="200"/>
                <DataGridTextColumn Header="First IP" SortMemberPath="FirstIP" Binding="{Binding FirstIP}" Width="130"/>
                <DataGridTextColumn Header="Last IP" SortMemberPath="LastIP" Binding="{Binding LastIP}" Width="130"/>
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="110"/>
                <DataGridTextColumn Header="DNS Servers" Binding="{Binding DnsServers}" Width="200"/>
                <DataGridTextColumn Header="NM Gateway IP" Binding="{Binding NmGatewayIP}" Width="150"/>
                <DataGridTextColumn Header="Gateway Port" Binding="{Binding NmGatewayPort}" Width="100"/>
                <DataGridCheckBoxColumn Header="auto scan" Binding="{Binding AutomaticScan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Scan Interval (min)" Binding="{Binding ScanIntervalMinutes}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Aktionsleiste unten -->
        <Grid Grid.Row="2" Margin="10,7,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="301"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="109"/>
                <ColumnDefinition Width="166"/>
            </Grid.ColumnDefinitions>
            <Button Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="111" Height="20"
                    Command="{Binding DeleteEntryCommand}" Background="#BFA4B1BF" OpacityMask="Black" TabIndex="12">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Width="103">
                    <Image Source="/Resources/DeleteBlack.png" Height="14" Margin="5,0,0,0" />
                    <Label Content="delete entry" Width="78" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                </StackPanel>
            </Button>
            <Button Content="Save Changes" VerticalAlignment="Center" Margin="38,0,10,0" Height="20" TabIndex="13" Grid.Column="5"
                    Command="{Binding SaveChangesCommand}" Background="#BFA4B1BF" OpacityMask="Black">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Eingabemaske oben -->
        <Grid Margin="10,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="134"/>
                <ColumnDefinition Width="113"/>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition Width="187"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="169"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="20"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <CheckBox Content="is active" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Height="16" Width="78" Margin="27,0,0,0" TabIndex="1"
                      IsChecked="{Binding EditIsActive, Mode=TwoWay}"/>
            <Label Content="Group Description" Margin="4,0,10,0" VerticalAlignment="Center" Height="24" Grid.Column="1"/>
            <Label Grid.Column="3" Content="First IP or Hostname" HorizontalAlignment="Center" VerticalAlignment="Center" Height="26" Width="116"/>
            <TextBox Grid.Column="1" Margin="9,0,2,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Height="18" TabIndex="2"
                     Text="{Binding EditIpGroupDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="3" Margin="10,0,10,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Height="18" TabIndex="4"
                     Text="{Binding EditFirstIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="4" Content="Last IP" Margin="10,0,10,0" VerticalAlignment="Center" Height="26"/>
            <TextBox Grid.Column="4" Margin="10,0,10,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Height="18" TabIndex="5"
                     Text="{Binding EditLastIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="6" Content="DNS Server IPs (allow comma without space)" HorizontalAlignment="Center" VerticalAlignment="Center" Height="26" Width="248"/>
            <TextBox Grid.Column="6" Margin="10,0,10,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Height="18" TabIndex="7"
                     Text="{Binding EditDnsServers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="2" Content="Device Description" VerticalAlignment="Center" Margin="10,0,10,0" Height="26"/>
            <TextBox Grid.Column="2" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,10,0" Height="18" TabIndex="3"
                     Text="{Binding EditDeviceDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="9" Margin="10,0,10,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Height="18" TabIndex="10"
                     Text="{Binding EditScanIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Column="5" Content="Domain" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Height="26" Width="52"/>
            <TextBox Grid.Column="5" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="86" Height="18" TabIndex="6"
                     Text="{Binding EditDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Column="9" Content="scan every xxx minutes" Margin="10,0,10,0" VerticalAlignment="Center" Height="16"
                      IsChecked="{Binding EditAutomaticScan, Mode=TwoWay}"/>
            <Label Grid.Column="7" Content="Gateway (router of this network)" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26" Width="180" Margin="10,0,0,0"/>
            <Label Grid.Column="8" Content="Scanned by" HorizontalAlignment="Left" VerticalAlignment="Center" Width="82" Height="26" Margin="10,0,0,0"/>
            <TextBox Grid.Column="7" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="162" Height="18" TabIndex="8"
                     Text="{Binding EditNmGatewayIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="8" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="108" Height="18" TabIndex="9"
                     Text="{Binding EditScannedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="9" HorizontalAlignment="Center" VerticalAlignment="Center" Width="149" Height="20" TabIndex="9" Grid.Row="2"
                    Command="{Binding AddEntryCommand}" Background="#BFA4B1BF" OpacityMask="Black">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Width="103">
                    <Image Source="/Resources/AddBlack.png" Height="14" Margin="5,0,0,0" />
                    <Label Content="add entry" Width="78" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="0" VerticalAlignment="Center" Height="20" Grid.Row="2" HorizontalAlignment="Center" Width="108"
                    Command="{Binding EditRowCommand}" Background="#BFA4B1BF" OpacityMask="Black">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Width="103">
                    <Image Source="/Resources/EditBlack.png" Height="14" Margin="5,0,0,0" />
                    <Label Content="edit entry" Width="78" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
