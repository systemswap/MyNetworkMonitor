<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows builds (built on Windows, or for a win-* runtime from Linux with EnableWindowsTargeting=true, see
      publish.sh) target net10.0-windows so that the Windows providers (MyNetworkMonitor.Platform.Windows) can be
      referenced; all others stay on the neutral net10.0 with the Linux providers. The SDK defines the symbol
      WINDOWS for net*-windows, which App.axaml.cs uses to choose the registrations.
    -->
    <MnmWindowsBuild>false</MnmWindowsBuild>
    <MnmWindowsBuild Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $(RuntimeIdentifier.StartsWith('win'))">true</MnmWindowsBuild>
    <TargetFramework Condition="'$(MnmWindowsBuild)' == 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(MnmWindowsBuild)' != 'true'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\NetworkScanner.ico</ApplicationIcon>

    <!--
      Application version. The last component is incremented with every
      release; the main window shows it in its title.
    -->
    <Version>7.3.0.28</Version>
    <AssemblyVersion>7.3.0.28</AssemblyVersion>
    <FileVersion>7.3.0.28</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyNetworkMonitor.Core\MyNetworkMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(MnmWindowsBuild)' == 'true'">
    <ProjectReference Include="..\MyNetworkMonitor.Platform.Windows\MyNetworkMonitor.Platform.Windows.csproj" />
    <!--
      Lets the same application run as a Windows service in satellite mode.
      The package provides the connection to the Service Control Manager;
      without it the process is killed after about 30 seconds because it
      never reports itself as started.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <!--
    Files read from the output directory at run time: the MAC vendor list
    (SupportMethods) and the 3d-force-graph library, which
    TopologyGraph.EnsureLocalLibrary copies into the graph folder.
  -->
  <ItemGroup>
    <!--
      Both large files live in the shared ..\Assets folder so that they are not
      duplicated per UI project. Link sets the path in the output directory
      that the runtime expects.
    -->
    <None Include="..\Assets\MacVendors\mac_vendors.csv" Link="MacVendors\mac_vendors.csv"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Assets\3dForceGraphLib\3d-force-graph.min.js" Link="3dForceGraphLib\3d-force-graph.min.js"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Images embedded in the assembly (avares://) -->
  <ItemGroup>
    <AvaloniaResource Include="Images\DevDonationCuted.jpg" />
    <AvaloniaResource Include="Images\PayPal.png" />
  </ItemGroup>
</Project>
