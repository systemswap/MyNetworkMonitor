<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyNetworkMonitor.Avalonia.Controls"
             x:Class="MyNetworkMonitor.Avalonia.App"
             RequestedThemeVariant="Light">
             <!-- Fix auf "Light": das WPF-Original ist ein helles Design (WhiteSmoke,
                  schwarze Schrift). Mit "Default" wuerde bei dunklem System-Theme
                  weisse Schrift auf hellem Hintergrund gerendert. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!--
            Projektweit: Spalten richten sich nach Kopfzeile und Zellinhalt.
            DataGridLength.Auto ist das Maximum aus beidem, damit weder die
            Ueberschrift noch ein Wert abgeschnitten wird. Gilt fuer jedes
            DataGrid der Anwendung - auch fuer Spalten, die spaeter im AXAML
            ergaenzt werden, solange sie keine eigene Breite setzen.
        -->
        <Style Selector="DataGrid">
            <Setter Property="ColumnWidth" Value="Auto"/>

            <!--
                Die horizontale Bildlaufleiste liegt im DataGrid-Template ueber
                dem Zeilenbereich und verdeckt sonst die letzte Zeile - man
                scrollt ans Ende und sieht sie trotzdem nicht.
            -->
            <Setter Property="controls:DataGridBehaviors.ReserveHorizontalScrollBarSpace" Value="True"/>
        </Style>
    </Application.Styles>
</Application>
