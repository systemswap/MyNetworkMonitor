<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyNetworkMonitor.Avalonia.Controls"
             x:Class="MyNetworkMonitor.Avalonia.App"
             RequestedThemeVariant="Light">
             <!-- Fixed to "Light": the layout uses a light design (WhiteSmoke,
                  black text). With "Default", a dark system theme would render
                  white text on the light backgrounds. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!--
            Application-wide: columns size to both header and cell content.
            DataGridLength.Auto is the maximum of both, so neither the header
            nor a value is truncated. Applies to every DataGrid in the
            application and to every column that does not set its own width.
        -->
        <Style Selector="DataGrid">
            <Setter Property="ColumnWidth" Value="Auto"/>

            <!--
                The DataGrid template places the horizontal scroll bar over the
                row area, where it would otherwise cover the last row: scrolled
                to the end, that row still stays hidden.
            -->
            <Setter Property="controls:DataGridBehaviors.ReserveHorizontalScrollBarSpace" Value="True"/>
        </Style>
    </Application.Styles>
</Application>
