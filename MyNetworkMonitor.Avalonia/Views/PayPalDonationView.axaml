<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyNetworkMonitor.Avalonia.Views.PayPalDonationView"
        Title="Thanks to support this project"
        Width="785" Height="589" MinWidth="484" MinHeight="461"
        WindowStartupLocation="CenterOwner">

    <!--
        Donation window.

        Avalonia's Width/Height cover only the client area, not the frame.
        785 x 589 is the client area of an 801 x 628 outer window with a
        standard frame (8 points per side, 31-point title bar), measured with
        GetWindowRect/GetClientRect. With 801 x 628 as client size the area
        would be 16 points wider and 39 points taller, so the background image
        would show a different section and the white card would sit elsewhere.
        The minimum size is derived the same way from an outer 500 x 500.
    -->

    <Window.Resources>
        <!--
            Rounded button: the ControlTemplate replaces the Button completely
            with a Border with CornerRadius 2 and centered content.

            Without it, the Fluent theme adds its own borders, padding and, above
            all, its own PointerOver/Pressed backgrounds. The blue then disappears
            on hover, and padding plus the fixed size shift the label.
        -->
        <ControlTheme x:Key="RoundedButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="#0070BA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- Subtle shades of blue instead of the Fluent grey states -->
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#0086DE"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#005B96"/>
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Grid Background="#F5F7FA">
        <!-- Background image -->
        <Image Source="avares://MyNetworkMonitor.Avalonia/Images/DevDonationCuted.jpg"
               Stretch="UniformToFill" Opacity="0.9"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <!--
            Shadow: a depth of 3 in the direction 315 degrees, i.e. 3 * cos 45
            = about 2 points to the right and down, not 3 per axis. Blur radius
            10, black at opacity 0.2 (alpha 0x33).
        -->
        <Border Background="White" Padding="20" CornerRadius="20" Margin="151,64,151,140"
                BoxShadow="2 2 10 0 #33000000">

            <StackPanel Margin="-20,0,-20,3">

                <Image Source="avares://MyNetworkMonitor.Avalonia/Images/PayPal.png"
                       Width="180" Height="80" Margin="0,20,0,10"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>

                <!-- Headline -->
                <TextBlock Text="Make a Difference Today ❤️" FontSize="18" FontWeight="Bold" Foreground="Black"
                           HorizontalAlignment="Center" Margin="0,5,0,10"/>

                <!-- Short explanation -->
                <TextBlock Text="Your support keeps such projects alive."
                           FontSize="14" Foreground="Gray" TextAlignment="Center"
                           HorizontalAlignment="Center" Width="300" Margin="0,0,0,15"/>

                <!-- Amount and currency on one line -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <TextBox x:Name="AmountTextBox" Width="80" FontSize="28"
                             TextAlignment="Center" Text="25"/>
                    <TextBlock x:Name="CurrencyTextBlock" Text="USD" FontSize="24" Foreground="Gray"
                               Margin="5,0,0,0" Height="29"/>
                </StackPanel>

                <!-- Filler -->
                <TextBlock x:Name="filler"
                           Text="feeling better when"
                           FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,10"/>

                <!-- Donate button -->
                <Button x:Name="DonatePayPalButton"
                        Content="Donate Now 🚀"
                        Click="DonateWithPayPal_Click"
                        Theme="{StaticResource RoundedButtonTheme}"
                        Width="250" Height="50" Margin="1"/>

                <!-- Social Proof -->
                <TextBlock x:Name="DonationCountTextBlock"
                           Text="Even a small donation helps!"
                           FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

        </Border>
    </Grid>
</Window>
