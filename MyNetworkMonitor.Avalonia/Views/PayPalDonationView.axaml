<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyNetworkMonitor.Avalonia.Views.PayPalDonationView"
        Title="Thanks to support this project"
        Width="801" Height="628" MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <!-- Originalgetreue Portierung von PayPalDonation.xaml (WPF). -->

    <Window.Resources>
        <!--
            Entspricht dem RoundedButtonStyle des WPF-Fensters: dort ersetzt ein
            ControlTemplate den Button vollstaendig durch einen Border mit
            CornerRadius 2 und mittig sitzendem Inhalt.

            Avalonias Fluent-Theme braucht dieselbe Behandlung, sonst legt es
            eigene Raender, Innenabstaende und - vor allem - eigene Hintergruende
            fuer PointerOver/Pressed darueber. Das Blau verschwindet dann beim
            Ueberfahren, und Padding plus feste Groesse verschieben die Beschriftung.
        -->
        <ControlTheme x:Key="RoundedButtonTheme" TargetType="Button">
            <Setter Property="Background" Value="#0070BA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- Dezente Abstufung statt der Fluent-Graustufen -->
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#0086DE"/>
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background" Value="#005B96"/>
            </Style>
        </ControlTheme>
    </Window.Resources>
    <Grid Background="#F5F7FA">
        <!-- Hintergrundbild -->
        <Image Source="avares://MyNetworkMonitor.Avalonia/Images/DevDonationCuted.jpg"
               Stretch="UniformToFill" Opacity="0.9"
               RenderOptions.BitmapInterpolationMode="HighQuality"/>

        <Border Background="White" Padding="20" CornerRadius="20" Margin="151,64,151,140"
                BoxShadow="3 3 10 0 #33000000">

            <StackPanel Margin="-20,0,-20,3">

                <Image Source="avares://MyNetworkMonitor.Avalonia/Images/PayPal.png"
                       Width="180" Height="80" Margin="0,20,0,10"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>

                <!-- Emotionale Headline -->
                <TextBlock Text="Make a Difference Today ❤️" FontSize="18" FontWeight="Bold" Foreground="Black"
                           HorizontalAlignment="Center" Margin="0,5,0,10"/>

                <!-- Kurzer Erklärtext -->
                <TextBlock Text="Your support keeps such projects alive."
                           FontSize="14" Foreground="Gray" TextAlignment="Center"
                           HorizontalAlignment="Center" Width="300" Margin="0,0,0,15"/>

                <!-- Betrag + Währung in einer Zeile -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <TextBox x:Name="AmountTextBox" Width="80" FontSize="28"
                             TextAlignment="Center" Text="25"/>
                    <TextBlock x:Name="CurrencyTextBlock" Text="USD" FontSize="24" Foreground="Gray"
                               Margin="5,0,0,0" Height="29"/>
                </StackPanel>

                <!-- Filler -->
                <TextBlock x:Name="filler"
                           Text="feeling better when"
                           FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,10"/>

                <!-- Spenden-Button -->
                <Button x:Name="DonatePayPalButton"
                        Content="Donate Now 🚀"
                        Click="DonateWithPayPal_Click"
                        Theme="{StaticResource RoundedButtonTheme}"
                        Width="250" Height="50" Margin="1"/>

                <!-- Social Proof -->
                <TextBlock x:Name="DonationCountTextBlock"
                           Text="Even a small donation helps!"
                           FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

        </Border>
    </Grid>
</Window>
