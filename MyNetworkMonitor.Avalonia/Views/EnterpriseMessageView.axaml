<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyNetworkMonitor.Avalonia.Views.EnterpriseMessageView"
        Title="Notice: Enterprise Network detected."
        Width="484" Height="311"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <!--
        Notice shown in an enterprise network: white container with shadow,
        headline, license and support text, contact link and an OK button with
        a countdown (clickable only after it expires). Closing the window with
        X exits the application.

        Avalonia sizes only the client area, without frame and title bar.
        484x311 is the client area of a window with an outer size of 500x350
        at 100 percent scaling.
    -->
    <Window.Styles>
        <!--
            Fluent recolors buttons on hover, on press and when disabled. This
            button stays blue in every state; while it is locked, it shows grey
            text on the same blue. Without these four rules the button would be
            grey on grey for the whole countdown, which is the state that is
            visible longest.
        -->
        <Style Selector="Button#CloseButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style Selector="Button#CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
        </Style>

        <Style Selector="Button#CloseButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
        </Style>

        <Style Selector="Button#CloseButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
            <Setter Property="Foreground" Value="#A9A9A9"/>
        </Style>

        <!--
            Same reason for the link: HyperlinkButton brings padding, a minimum
            height of 32 and its own hover background. The link is meant to sit
            inline on the baseline of the sentence; with the Fluent metrics it
            would take up a line of its own.
        -->
        <Style Selector="HyperlinkButton#EmailLink">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="HyperlinkButton#EmailLink /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="HyperlinkButton#EmailLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0070BA"/>
        </Style>
    </Window.Styles>

    <Border Background="White" Padding="20" CornerRadius="10" BoxShadow="2 2 10 0 #33000000">
        <!-- Centered horizontally only, aligned to the top vertically
             (StackPanel default is Stretch, content flows from the top). -->
        <StackPanel HorizontalAlignment="Center">

            <!-- Headline -->
            <TextBlock Text="Make a Difference Today ❤️"
                       FontSize="18" FontWeight="Bold" Foreground="#0070BA"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,10"/>

            <!-- Main message -->
            <TextBlock Text="Free for private use, non-profit clubs, schools and charities.&#10;Companies and public authorities need a license,&#10;also to use it only in their own network."
                       FontSize="14" Foreground="Black"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,15"/>

            <!-- Developer support -->
            <TextBlock Text="This project has taken around 500 hours to develop until this version,&#10;and even independent developers need coffee ☕."
                       FontSize="13" Foreground="Gray"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,15"/>

            <!-- Contact link. FontSize 12 is set explicitly: without it, Fluent
                 uses 14, which makes the sentence larger than the line above. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="If you need a licensed version, contact me: "
                           FontSize="12" VerticalAlignment="Center"/>
                <HyperlinkButton x:Name="EmailLink"
                                 Content="systemswap@tuta.io"
                                 NavigateUri="mailto:systemswap@tuta.io"
                                 Foreground="#0070BA" FontSize="14" FontWeight="Bold"
                                 VerticalAlignment="Center"/>
            </StackPanel>

            <!-- OK button with countdown -->
            <Button x:Name="CloseButton"
                    Content="You can click OK in: 3 seconds"
                    Width="250" Height="50"
                    Background="#0070BA" Foreground="#A9A9A9" FontWeight="Bold"
                    Margin="0,20,0,0" Cursor="Hand" IsEnabled="False"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Border>
</Window>
