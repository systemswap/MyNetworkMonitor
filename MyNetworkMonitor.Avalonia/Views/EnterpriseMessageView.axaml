<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyNetworkMonitor.Avalonia.Views.EnterpriseMessageView"
        Title="Notice: Enterprise Network detected."
        Width="484" Height="311"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <!--
        Originalgetreue Portierung von ZZZ_EnterpriseUsage.ShowEnterpriseMessage()
        (WPF, programmatisch gebaut). Design und Verhalten 1:1: weisser Container
        mit Schatten, Headline, Lizenz-/Support-Text, Kontakt-Link und OK-Button
        mit Countdown (erst nach Ablauf klickbar). X schliesst die Anwendung.

        Die Fenstermasse sind bewusst nicht 500x350 wie im Original: WPF misst
        das ganze Fenster samt Rahmen und Titelleiste, Avalonia nur die
        Innenflaeche. Uebernommen ergaeben dieselben Zahlen ein sichtbar
        groesseres Fenster - 484x311 ist die Innenflaeche eines 500x350 grossen
        WPF-Fensters bei hundert Prozent Skalierung.
    -->
    <Window.Styles>
        <!--
            Fluent faerbt Schalter beim Ueberfahren, beim Druecken und im
            gesperrten Zustand selbst um. Das Original tut nichts davon: der
            Knopf bleibt blau, und waehrend der Sperre steht graue Schrift auf
            eben diesem Blau. Ohne diese vier Regeln waere der Knopf die ganze
            Wartezeit ueber grau in grau - der auffaelligste Unterschied
            ueberhaupt, weil er genau den Zustand betrifft, den man am
            laengsten sieht.
        -->
        <Style Selector="Button#CloseButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style Selector="Button#CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
        </Style>

        <Style Selector="Button#CloseButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
        </Style>

        <Style Selector="Button#CloseButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0070BA"/>
            <Setter Property="Foreground" Value="#A9A9A9"/>
        </Style>

        <!--
            Derselbe Grund beim Link: der HyperlinkButton bringt Polsterung,
            eine Mindesthoehe von 32 und einen eigenen Hintergrund beim
            Ueberfahren mit. Im Original ist es ein Hyperlink mitten im Satz,
            der nichts davon hat - er sitzt auf der Grundlinie des Textes und
            haette mit Fluent-Masse eine Zeile fuer sich.
        -->
        <Style Selector="HyperlinkButton#EmailLink">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="HyperlinkButton#EmailLink /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="HyperlinkButton#EmailLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0070BA"/>
        </Style>
    </Window.Styles>

    <Border Background="White" Padding="20" CornerRadius="10" BoxShadow="2 2 10 0 #33000000">
        <!-- Wie im WPF-Original: nur horizontal zentriert, vertikal oben-ausgerichtet
             (StackPanel-Default = Stretch, Inhalt fliesst von oben). -->
        <StackPanel HorizontalAlignment="Center">

            <!-- Ueberschrift -->
            <TextBlock Text="Make a Difference Today ❤️"
                       FontSize="18" FontWeight="Bold" Foreground="#0070BA"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,10"/>

            <!-- Hauptnachricht -->
            <TextBlock Text="This software is free for private use only.&#10;For companies and commercial usage, a license is required."
                       FontSize="14" Foreground="Black"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,15"/>

            <!-- Entwickler-Unterstuetzung -->
            <TextBlock Text="This project has taken around 500 hours to develop until this version,&#10;and even Open-Source developers need coffee ☕."
                       FontSize="13" Foreground="Gray"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,15"/>

            <!-- Kontakt-Link. FontSize 12 steht ausdruecklich da: das Original
                 gibt dem Satz keine Groesse und bekommt damit die 12 von WPF;
                 Fluent wuerde ihn ohne Angabe mit 14 setzen und damit groesser
                 als die Zeile darueber. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="If you need a licensed version, contact me: "
                           FontSize="12" VerticalAlignment="Center"/>
                <HyperlinkButton x:Name="EmailLink"
                                 Content="systemswap@tuta.io"
                                 NavigateUri="mailto:systemswap@tuta.io"
                                 Foreground="#0070BA" FontSize="14" FontWeight="Bold"
                                 VerticalAlignment="Center"/>
            </StackPanel>

            <!-- OK-Button mit Countdown -->
            <Button x:Name="CloseButton"
                    Content="You can click OK in: 3 seconds"
                    Width="250" Height="50"
                    Background="#0070BA" Foreground="#A9A9A9" FontWeight="Bold"
                    Margin="0,20,0,0" Cursor="Hand" IsEnabled="False"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Border>
</Window>
