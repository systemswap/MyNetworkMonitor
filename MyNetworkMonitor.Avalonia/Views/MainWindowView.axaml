<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyNetworkMonitor.Avalonia.Views.MainWindowView"
        x:CompileBindings="False"
        Title="My Network Monitor"
        Height="806" Width="1849" MinWidth="1849" MinHeight="806"
        Background="WhiteSmoke"
        FontFamily="Segoe UI" FontSize="12">

    <!--
        Fenstergroesse: WPFs Width/Height (1865x845) sind Fenstermasse inklusive
        Rahmen und Titelleiste, Avalonias Width/Height dagegen die Client-Groesse.
        1849x806 entspricht damit exakt der Zeichenflaeche der WPF-Form.

        Originalgetreue Layout-Portierung von MainWindow.xaml (WPF).
        Alle Controls sind an ihren Grid-Positionen uebernommen. Noch offen /
        in Avalonia abweichend (in spaeteren Schritten): DataGrid-Gruppierung
        (GroupStyle), Bild-Status-Spalten, Row-Color-Trigger, AutoGeneratingColumn.
        Die Event-Handler sind als Stubs vorhanden (Logik folgt).
        Hinweis: WPFs CanUserAddRows="False" entfaellt - Avalonias DataGrid kennt
        die Eigenschaft nicht und legt grundsaetzlich keine neuen Zeilen an.
    -->

    <Window.Resources>
        <!--
            CheckBox / RadioButton: das Fluent-Theme reserviert eine feste 20px-Spalte
            fuer das Kaestchen, erzwingt MinHeight 32 und setzt TextWrapping="Wrap".
            Damit brechen die aus WPF uebernommenen Beschriftungen ("scan Hostname",
            "NetBios", "arp -d", ...) in ihren fixen Breiten um und die Zeilen
            ueberlappen sich. Darum hier kompakte, WPF-nahe Templates:
            13px-Kaestchen, 4px Abstand, kein Zeilenumbruch, keine Mindesthoehe.
        -->
        <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <!-- WPFs Control-Default ist Top (nicht Center): Controls mit grosser
                 fixer Hoehe wie chk_Methodes_ONVIF (34px) oder chk_ARP_DeleteCacheBefore
                 (32px) sitzen im Original oben, nicht mittig. -->
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <Border x:Name="Box" Width="13" Height="13" CornerRadius="2" Margin="0,1,0,0"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Path x:Name="CheckGlyph" IsVisible="False" Stretch="Uniform" Margin="1.5"
                                  Fill="#FF212121"
                                  Data="M 0,4.5 L 3.2,7.6 L 9.4,0.4 L 10.8,1.7 L 3.3,10.3 L -1.2,5.8 Z"/>
                            <!-- Zwischenzustand -->
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:checked /template/ Path#CheckGlyph">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:indeterminate /template/ Path#CheckGlyph">
                <Setter Property="IsVisible" Value="True"/>
                <Setter Property="Opacity" Value="0.4"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#Box">
                <Setter Property="BorderBrush" Value="#FF1196A7"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.55"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <!-- WPFs Control-Default ist Top (nicht Center): Controls mit grosser
                 fixer Hoehe wie chk_Methodes_ONVIF (34px) oder chk_ARP_DeleteCacheBefore
                 (32px) sitzen im Original oben, nicht mittig. -->
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <Border x:Name="Box" Width="13" Height="13" CornerRadius="7" Margin="0,1,0,0"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Ellipse x:Name="CheckGlyph" Width="6" Height="6" IsVisible="False"
                                     Fill="#FF212121" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
            <Style Selector="^:pointerover /template/ Border#Box">
                <Setter Property="BorderBrush" Value="#FF1196A7"/>
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.55"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!--
            WPF-Metriken.
            Das Fluent-Theme ist deutlich groesser dimensioniert als WPF
            (FontSize 14 statt 12, MinHeight 32 bei TextBox/Button/CheckBox/
            ComboBox/Slider, TabItem-FontSize 24, grosse Paddings).
            Da alle Controls die Pixel-Positionen und -Hoehen des WPF-Originals
            (Height="14".."22") uebernommen haben, wuerden die Fluent-MinHeights
            die Werte hochklemmen -> alles ueberlappt. Darum hier ueberall
            MinHeight/MinWidth auf 0 und WPF-nahe Paddings.
        -->
        <Style Selector="Label">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="5,5,5,5"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>

        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style Selector="HyperlinkButton">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- DataGrid: WPF-Zeilenhoehe ~22px statt Fluent ~40px, dazu der
             WPF-typische Rahmen und das Gitternetz (Fluent zeichnet keines). -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF688CAF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFC9CACA"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFC9CACA"/>
            <!-- Keine feste RowHeight: WPF laesst die Zeilen mitwachsen, damit
                 mehrzeilige Werte (SNMPInfos, mDNSInfos, Aliases, TCP_Ports)
                 vollstaendig sichtbar sind. -->
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <!-- Teal-Optik der Tabs (Naeherung an das WPF-Custom-Template) -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Background" Value="#7F1196A7"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="22"/>
            <!-- WPFs TabPanel streckt die Tabs auf die Breite der Leiste (319px).
                 Avalonia nutzt einen WrapPanel, darum sind die Breiten je Tab
                 direkt am TabItem gesetzt (Summe pro Zeile = 319). -->
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- Kein Hover-Effekt: das WPF-Template kennt nur IsSelected True/False -->
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#FF1196A7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!--
            Fluent zeichnet unter dem aktiven Tab eine blaue "Pipe" - im
            WPF-Template nicht vorhanden und hier unerwuenscht, weil der aktive
            Tab sich ohnehin einfaerbt. Die Pipe wird ueber mehrere Wege gesetzt
            (Groesse, Sichtbarkeit, Hintergrund), darum alle abschalten.
        -->
        <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!--
            Gruppenkopf der Ergebnistabelle: WPFs GroupStyle zeigte neben dem
            Gruppennamen die Anzahl der Geraete. Avalonias DataGrid kann das
            ueber IsItemCountVisible / ItemCountFormat.
        -->
        <Style Selector="DataGridRowGroupHeader">
            <Setter Property="IsItemCountVisible" Value="True"/>
            <Setter Property="ItemCountFormat" Value="({0} Devices)"/>
            <Setter Property="IsPropertyNameVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="339"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="29"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="57"/>
            <RowDefinition/>
            <RowDefinition Height="30" MinHeight="44.04"/>
        </Grid.RowDefinitions>

        <!-- ======================= LINKS: TabControl ======================= -->
        <TabControl Margin="10,0,10,10" Grid.Row="2" Background="WhiteSmoke">

            <!-- Tab:From NIC -->
            <TabItem x:Name="Tab_FromNIC" Header="From NIC" Width="102">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155*"/>
                        <ColumnDefinition Width="158*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Label Content="Select Network Interface" Grid.ColumnSpan="2" Margin="10,15,10,0" VerticalContentAlignment="Bottom" Background="#991196A7"/>
                    <ComboBox x:Name="cb_NetworkAdapters" Width="293" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="cb_NetworkAdapters_SelectionChanged" Grid.ColumnSpan="2" Margin="10,5,0,0" Grid.Row="1" Height="22"/>
                    <TextBox x:Name="tb_AdapterIP" IsReadOnly="True" Width="135" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#FFEFEFEF" Grid.Row="3" Margin="0,1,0,0" Height="18"/>
                    <Label Content="IP Address" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Grid.Row="2" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Left" Width="135" Background="#991196A7" Height="26"/>
                    <Label Content="Subnetmask" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Column="1" Margin="0,12,0,0" Grid.Row="2" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Left" Width="138" Background="#991196A7" Height="26"/>
                    <TextBox x:Name="tb_AdapterSubnetMask" IsReadOnly="True" Width="138" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#FFEFEFEF" Grid.Row="3" Grid.Column="1" Margin="0,1,0,0" Height="18"/>
                    <Label Content="First Subnet IP" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Grid.Row="4" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Left" Width="135" Background="#991196A7" Height="26"/>
                    <Label Content="Last Subnet IP" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Column="1" Margin="0,12,0,0" Grid.Row="4" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Left" Width="138" Background="#991196A7" Height="26"/>
                    <TextBox x:Name="tb_Adapter_FirstSubnetIP" Width="135" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="tb_Adapter_FirstSubnetIP_TextChanged" Margin="0,1,0,0" Grid.Row="5" Height="18"/>
                    <TextBox x:Name="tb_Adapter_LastSubnetIP" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="tb_Adapter_LastSubnetIP_TextChanged" Grid.Row="5" Grid.Column="1" Margin="0,1,0,0" HorizontalAlignment="Center" Width="138" Height="18"/>

                    <Button x:Name="bt_StopScanFromNIC" Background="#BFC86C6C" Content="stop scan" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Grid.Row="9" HorizontalContentAlignment="Center" Grid.Column="0" Height="20" Margin="24,0,0,0" CornerRadius="5" Click="StopScanning_Click"/>
                    <Button x:Name="bt_StartScanFromNIC" Background="#9972D251" Content="start scan" HorizontalAlignment="Center" VerticalAlignment="Center" Width="138" Grid.Row="9" HorizontalContentAlignment="Center" Click="bt_StartScanFromNIC_Click" Grid.Column="1" Height="30" CornerRadius="5"/>

                    <Label Content="TimeOut Portscan:" HorizontalAlignment="Left" VerticalAlignment="Top" Height="25" Width="108" VerticalContentAlignment="Bottom" Margin="10,37,0,0" Grid.Row="5" Grid.RowSpan="2"/>
                    <Label Content="{Binding #slider_TimeOut.Value}" HorizontalAlignment="Left" Margin="152,34,0,0" VerticalAlignment="Top" Height="25" VerticalContentAlignment="Bottom" Grid.ColumnSpan="2" Grid.Row="5" Grid.RowSpan="2"/>
                    <Slider x:Name="slider_TimeOut" HorizontalAlignment="Left" VerticalAlignment="Top" Width="286" Maximum="3000" Minimum="10" Value="1000" TickFrequency="10" SmallChange="10" LargeChange="50" Grid.Row="6" IsSnapToTickEnabled="True" ValueChanged="slider_TimeOut_ValueChanged" Height="18" Grid.ColumnSpan="2" Margin="10,22,0,0"/>

                    <Label Content="IPs to Scan:" Grid.Row="8" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Left" HorizontalAlignment="Left" Width="145" Height="23" VerticalAlignment="Center" Margin="10,0,0,0" Background="#991196A7"/>
                    <Label x:Name="lb_IPsToScan" Content="..." Grid.Row="8" Grid.Column="1" Height="23" VerticalAlignment="Center" HorizontalAlignment="Left" Width="148" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Center" Background="#991196A7"/>
                    <Label Content="Attention:&#10;all scanning methods are sent&#10;via the selected network interface" HorizontalAlignment="Left" Margin="10,0,0,10" Grid.Row="6" Grid.ColumnSpan="2" FontWeight="Bold" Height="58" VerticalAlignment="Bottom"/>
                    <Label Content="recognized DNS Server:" Margin="0,70,0,0" Grid.Row="6" Height="26" VerticalAlignment="Top" HorizontalAlignment="Center" Width="135"/>
                    <ListBox x:Name="lstb_DNSServers" Margin="0,93,0,0" Grid.Row="6" VerticalAlignment="Top" HorizontalAlignment="Center" Width="127" Height="85"/>
                </Grid>
            </TabItem>

            <!-- Tab:From IP Ranges -->
            <TabItem x:Name="tab_FromIPRange" Header="From IP Ranges" Width="104">
                <Grid x:Name="SummaryGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="bt_Edit_IP_Range" Content="edit IP ranges" Margin="199,20,0,0" Click="bt_Edit_IP_Range_Click" Background="#BFA4B1BF" HorizontalAlignment="Left" Width="104" Height="20" VerticalAlignment="Top" CornerRadius="5"/>
                    <DataGrid x:Name="dgv_IP_Ranges" Margin="10,10,10,10" Grid.Row="1" AutoGenerateColumns="False" CanUserResizeColumns="True"/>
                    <CheckBox x:Name="chk_IPRanges_groupDevices" Content="group Devices" HorizontalAlignment="Left" Margin="10,25,0,0" VerticalAlignment="Top" Click="chk_IPRanges_groupDevices_Click"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="bt_StopScanFromRange" Background="#BFC86C6C" Content="stop scan" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Center" Grid.Column="0" Height="20" Margin="24,0,0,0" CornerRadius="5" Click="StopScanning_Click"/>
                        <Button x:Name="bt_Scan_IP_Ranges" Content="Scan IP Ranges" Click="bt_Scan_IP_Ranges_Click" Margin="8,5,10,5" Background="#9972D251" Grid.Column="1" Width="138" CornerRadius="5"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab:Ports To Scan -->
            <TabItem x:Name="tab_PortsToScan" Header="Ports To Scan" Width="113">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dg_PortsToScan" Margin="10,10,10,10" Grid.Row="1" AutoGenerateColumns="False"/>
                    <Button x:Name="bt_SavePortsToScan" Content="Save Port Collection" HorizontalAlignment="Center" Grid.Row="2" VerticalAlignment="Center" Width="293" Height="20" Click="bt_SavePortsToScan_Click" Background="#BFA4B1BF" CornerRadius="5"/>
                </Grid>
            </TabItem>

            <!-- Tab:Services -->
            <TabItem x:Name="tab_Services" Header="Services" Width="90">
                <Grid>
                    <!-- ColumnWidth="Auto": Spalten so breit wie Kopfzeile bzw. Inhalt -->
                    <DataGrid x:Name="dg_Services" AutoGenerateColumns="False" IsReadOnly="False" Margin="10,68,10,62"
                              ColumnWidth="Auto">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="contextMenu_dg_Services">
                                <MenuItem Header="get default ports)" Click="dg_ServicesGetDefaultPorts_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="toScan" Binding="{Binding [toScan], Mode=TwoWay}" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding [Service]}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ports" Binding="{Binding [Ports]}" IsReadOnly="False"/>
                            <DataGridTextColumn Header="HelloBytePackage" Binding="{Binding [HelloBytePackage]}" IsReadOnly="True" IsVisible="False"/>
                            <DataGridTextColumn Header="ResponsedBytePackagePart" Binding="{Binding [ResponsedBytePackagePart]}" IsReadOnly="True" IsVisible="False"/>
                            <DataGridTextColumn Header="ResponsedContainsString" Binding="{Binding [ResponsedContainsString]}" IsReadOnly="True" IsVisible="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <CheckBox x:Name="chk_Services_showOnlyIsRunning" Content="show only running services" HorizontalAlignment="Left" Margin="43,34,0,0" VerticalAlignment="Top" Width="193" IsChecked="True" IsCheckedChanged="chk_Services_showOnlyIsRunning_Changed"/>
                </Grid>
            </TabItem>

            <!-- Tab:Hostname Mapping -->
            <TabItem x:Name="tab_InternalNames" Header="Hostname Mapping" Width="134">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,40,1,0" Grid.Row="2" Grid.RowSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="156*"/>
                            <ColumnDefinition Width="157*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="bt_SaveNames" Content="save names to xml" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#BFA4B1BF" Click="bt_SaveNames_Click" Grid.Column="1" Width="136" CornerRadius="5"/>
                        <Button x:Name="bt_AddInternalNamesToScanResult" Content="internal names to result" Background="#BFA4B1BF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="136" Click="bt_AddInternalNamesToScanResult_Click" CornerRadius="5"/>
                    </Grid>
                    <DataGrid x:Name="dg_InternalNames" Grid.Row="1" Margin="10,0,10,10" AutoGenerateColumns="False" CellEditEnding="dg_InternalNames_CellEditEnding" LoadingRow="dg_InternalNames_LoadingRow" RowEditEnding="dg_InternalNames_RowEditEnding">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Paste" Click="dg_InternalNames_ContextMenu_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <Label Content="Filter" HorizontalAlignment="Left" Margin="10,2,0,0" Grid.Row="2" VerticalAlignment="Top"/>
                    <TextBox x:Name="tb_InternalNamesFilter" HorizontalAlignment="Left" Margin="51,0,0,0" Grid.Row="2" TextWrapping="Wrap" VerticalAlignment="Center" Width="252" TextChanged="tb_InternalNamesFilter_TextChanged"/>
                    <Label Content="this color means hostname is listed in result table" HorizontalAlignment="Center" Margin="0,9,0,0" VerticalAlignment="Center" Width="293" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#FFD1F3D9"/>
                </Grid>
            </TabItem>

            <!-- Tab:Infos -->
            <TabItem x:Name="Infos" Header="Infos" Width="95">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="128"/>
                        <RowDefinition Height="271*"/>
                        <RowDefinition Height="137*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="bt_openApplicationFolder" Content="open application folder" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Click="bt_openApplicationFolder_Click" Width="133" Height="20"/>
                    <Button Grid.Row="1" x:Name="bt_opensettingsFolder" Content="open settings folder" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Click="bt_openSettingsFolder_Click" Width="133" Height="20"/>
                    <Label Content="colors for duplicated values, also in the visualisation" HorizontalAlignment="Center" Grid.Row="4" VerticalAlignment="Top" Height="26" Width="295" Margin="0,60,0,0"/>
                    <Label Content="   matched&#10;InternalName" Background="LightGreen" HorizontalAlignment="Left" Margin="10,2,0,0" Grid.Row="4" VerticalAlignment="Top" MinWidth="65" Width="70" FontSize="10" Height="37" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Label Content="IP-Address" Background="Yellow" HorizontalAlignment="Left" Margin="10,0,0,3" Grid.Row="4" VerticalAlignment="Bottom" MinWidth="65" Width="70" FontSize="10" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Label Content="Hostname" Background="DarkOrange" HorizontalAlignment="Left" Margin="85,0,0,3" Grid.Row="4" VerticalAlignment="Bottom" MinWidth="65" Width="70" FontSize="10" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Label Content="lookup IPs" Background="Cyan" HorizontalAlignment="Left" Margin="235,0,0,3" Grid.Row="4" VerticalAlignment="Bottom" MinWidth="65" Width="70" FontSize="10" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Label Content="Mac-Address" Background="#FFC73D3D" HorizontalAlignment="Left" Margin="160,0,0,3" Grid.Row="4" VerticalAlignment="Bottom" MinWidth="65" Width="70" FontSize="10" Foreground="WhiteSmoke" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Left" Grid.Row="5" TextWrapping="Wrap" Width="293" VerticalAlignment="Bottom" Height="227" Margin="12,0,0,10"
                               Text="Port Status:&#10;   isRunning:  service detected on this &#10;&#10;   error:   The port is open but&#10;         another service is running.&#10;&#10;   open:   The port is open and&#10;               actively accepting connections.&#10;&#10;   closed: The port responds but does&#10;               not have a listening service.&#10;&#10;   filtered: A firewall or filter is blocking the request&#10;                explicite rejection received or nothing.&#10;&#10;   no response: The target did not reply&#10;                         at all (possible network issue)."/>
                    <Image x:Name="img_Logo" Margin="14,15,14,12" Grid.Row="6"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ======================= OBEN RECHTS: Methoden-Raster ======================= -->
        <Grid x:Name="tb_Ports" Grid.Column="1" Margin="13,12,10,0" Grid.RowSpan="3" Height="73" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="25*"/>
                <RowDefinition Height="22*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="114"/>
                <ColumnDefinition Width="31"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="146"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="127"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="chk_Methodes_SSDP" Content="SSDP   &#x1F4FA;" HorizontalAlignment="Left" Width="80" VerticalContentAlignment="Bottom" VerticalAlignment="Bottom" Height="18" Margin="10,0,0,3"/>
            <CheckBox x:Name="chk_ARPRequest" Content="arp Request" VerticalAlignment="Bottom" Grid.Column="1" Height="18" VerticalContentAlignment="Bottom" HorizontalAlignment="Left" Width="102" Margin="10,0,0,3"/>
            <CheckBox x:Name="chk_Methodes_Ping" Content="Ping" Grid.Column="2" HorizontalAlignment="Center" Width="70" VerticalContentAlignment="Bottom" VerticalAlignment="Top" Height="18" Margin="0,18,0,0"/>
            <CheckBox x:Name="chk_Methodes_ScanHostnames" Content="scan Hostname" Grid.Column="3" HorizontalAlignment="Left" Width="104" VerticalContentAlignment="Bottom" VerticalAlignment="Bottom" Height="16" Margin="10,0,0,3"/>
            <CheckBox x:Name="chk_Methodes_ScanNetBios" Content="NetBios" Grid.Column="4" HorizontalAlignment="Left" Width="56" VerticalContentAlignment="Bottom" VerticalAlignment="Top" Height="19" Margin="10,17,0,0"/>
            <CheckBox x:Name="chk_Methodes_Scan_SMBVersions" Content="SMB" Grid.Column="5" HorizontalAlignment="Left" Width="49" VerticalContentAlignment="Bottom" VerticalAlignment="Top" Height="18" Margin="10,18,0,0" Grid.ColumnSpan="2"/>
            <CheckBox x:Name="chk_Methodes_Scan_Services" Content="Services" Grid.Column="6" HorizontalAlignment="Left" Width="71" VerticalContentAlignment="Bottom" VerticalAlignment="Top" Height="18" Margin="10,18,0,0"/>
            <CheckBox x:Name="chk_Methodes_ScanTCPPorts" Content="TCP Ports" Grid.Column="7" HorizontalAlignment="Left" Width="76" VerticalContentAlignment="Bottom" VerticalAlignment="Top" Height="18" Margin="10,18,0,0"/>

            <TextBox x:Name="tb_IP_Address" Grid.Column="12" TextWrapping="Wrap" VerticalAlignment="Center" Height="20" Margin="10,0,9,0"/>
            <TextBox x:Name="tb_TCPPorts" Grid.Column="13" TextWrapping="Wrap" VerticalAlignment="Center" Height="20" Margin="10,0,7,0"/>
            <Button x:Name="bt_ScanIP" Click="bt_ScanIP_Click" Content="scan above IP or selected row, if is empty" Grid.Column="12" VerticalAlignment="Center" Height="30" Margin="7,0,0,0" HorizontalAlignment="Left" Width="369" Grid.Row="1" Grid.ColumnSpan="3" Background="#9972D251" CornerRadius="5"/>

            <CheckBox x:Name="chk_Methodes_ARP_A" Content="arp -a" Margin="10,0,0,3" HorizontalAlignment="Left" Width="54" Grid.Column="9" VerticalContentAlignment="Center" VerticalAlignment="Bottom" Height="18"/>
            <CheckBox x:Name="chk_ARP_DeleteCacheBefore" Content="arp -d" VerticalAlignment="Top" Height="32" Click="chk_ARP_DeleteCacheBefore_Click" Grid.Column="9" Grid.Row="1" HorizontalAlignment="Left" Width="54" Margin="25,2,0,0"/>
            <TextBox x:Name="tb_DNSServerIP" Grid.Column="14" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="107" Height="18"/>
            <CheckBox x:Name="chk_Methodes_ONVIF" Content="ONVIF &#x1F4F7;" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Height="34" Width="80" Margin="10,2,0,0"/>
            <CheckBox x:Name="chk_Methodes_SNMP" Content="SNMP     &#x1F5A8;&#xFE0F;" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Height="15" Width="92" Margin="0,2,0,0"/>
            <CheckBox x:Name="chk_Methodes_mDNS" Content="mDNS" HorizontalAlignment="Center" Grid.Column="2" Grid.Row="1" VerticalAlignment="Top" Height="15" Width="70" Margin="0,2,0,0"/>
            <CheckBox x:Name="chk_Methodes_LookUp" Content="do Lookup scan" Grid.Row="1" Grid.Column="3" Margin="10,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="15" Width="104"/>
            <CheckBox x:Name="chk_allTCPPorts" Grid.Row="1" Grid.Column="7" Content="all Ports" VerticalAlignment="Center" Height="23" HorizontalAlignment="Center" Width="66"/>
        </Grid>

        <!-- ======================= Statuszeile ======================= -->
        <Label x:Name="lbl_ScanStatus" Content="..." Grid.Row="3" VerticalAlignment="Center" Height="26" Grid.ColumnSpan="2" HorizontalContentAlignment="Center" Margin="18,0,2,0"/>

        <!-- ======================= MITTE RECHTS: Ergebnisse + Filter ======================= -->
        <Grid Grid.Column="1" Grid.Row="2" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!--
                Spalten, Gruppierung und Bild-Status-Spalten kommen aus
                DataTableGridSource; die Zeilenfarben (in WPF DataGridRow-Trigger)
                setzt dgv_Results_LoadingRow.
            -->
            <DataGrid x:Name="dgv_Results" Grid.Row="0" Margin="10" AutoGenerateColumns="False" Background="#FFF0F0F0"
                      SelectionMode="Extended" LoadingRow="dgv_Results_LoadingRow" KeyDown="dgv_Results_KeyDown">
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="contextMenu">
                        <MenuItem Header="scan selected IPs (select method / services first)" Click="ScanSelectedIPs_Click"/>
                        <MenuItem Header="find port of one service (65536 Ports)" Click="SelectedIPFindServicePort_Click"/>
                        <MenuItem Header="resolve ip across dns servers" Click="resolve_ip_across_dns_servers_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="17*"/>
                    <RowDefinition Height="23*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="49"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="91"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="156"/>
                </Grid.ColumnDefinitions>

                <Label Content="Filter:" HorizontalAlignment="Center" VerticalAlignment="Center" Height="28" Width="40" VerticalContentAlignment="Center"/>
                <Label Grid.Column="1" Content="whole Table" HorizontalAlignment="Left" Margin="0,-6,0,0" VerticalAlignment="Top" Height="23" Width="124" Grid.ColumnSpan="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <Label Grid.Column="4" Content="IP (exact or with *)" HorizontalAlignment="Center" Margin="0,-6,0,0" VerticalAlignment="Top" Height="26" Width="111" VerticalContentAlignment="Center" Grid.RowSpan="2"/>
                <Label Grid.Column="5" Content="Hostname" HorizontalAlignment="Left" Margin="10,-6,0,0" VerticalAlignment="Top" Height="23" Width="64"/>
                <Label Grid.Column="6" Content="Internal Name" HorizontalAlignment="Left" Margin="10,-6,0,0" VerticalAlignment="Top" Height="23" Width="85"/>
                <Label Grid.Column="7" Content="TCP Port" HorizontalAlignment="Left" Margin="10,-6,0,0" VerticalAlignment="Top" Height="23" Width="55"/>
                <Label Grid.Column="8" Content="Mac" HorizontalAlignment="Left" Margin="10,-6,0,0" VerticalAlignment="Top" Height="23" Width="32"/>
                <Label Grid.Column="9" Content="Vendor" HorizontalAlignment="Left" Margin="10,-6,0,0" VerticalAlignment="Top" Height="23" Width="48"/>

                <TextBox x:Name="tb_Filter_All1" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="82" TextChanged="Filter_ScanResults_Explicite" Height="17" VerticalContentAlignment="Center" Grid.ColumnSpan="2" Margin="32,0,0,0"/>
                <TextBox x:Name="tb_Filter_All2" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="81" TextChanged="Filter_ScanResults_Explicite" Height="17" VerticalContentAlignment="Center" Grid.Column="3"/>
                <TextBox x:Name="tb_Filter_IP" Grid.Column="4" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="104" TextChanged="Filter_ScanResults_Explicite" Height="17"/>
                <TextBox x:Name="tb_Filter_HostName" Grid.Column="5" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="104" TextChanged="Filter_ScanResults_Explicite" Height="17"/>
                <TextBox x:Name="tb_Filter_InternalName" Grid.Column="6" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="104" TextChanged="Filter_ScanResults_Explicite" Height="17"/>
                <TextBox x:Name="tb_Filter_TCPPort" Grid.Column="7" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="104" TextChanged="Filter_ScanResults_Explicite" Height="17"/>
                <TextBox x:Name="tb_Filter_Mac" Grid.Column="8" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="104" TextChanged="Filter_ScanResults_Explicite" Height="17"/>
                <TextBox x:Name="tb_Filter_Vendor" Grid.Column="9" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center" Width="104" TextChanged="Filter_ScanResults_Explicite" Height="17"/>

                <CheckBox x:Name="chk_SaveLastScanResult" Content="save last scan result" Height="15" VerticalContentAlignment="Center" Width="128" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="True" Grid.Column="14" Margin="18,0,0,0"/>
                <Button x:Name="bt_exportResult" Content="export table" HorizontalAlignment="Center" VerticalAlignment="Center" Width="104" Background="#BFA4B1BF" Grid.Column="13" Grid.Row="1" Height="19" Click="bt_exportResult_Click" CornerRadius="5"/>
                <Button x:Name="bt_clearScanResultTable" Content="clear table" HorizontalAlignment="Left" VerticalAlignment="Center" Width="104" Click="bt_clearScanResultTable_Click" Background="#BFA4B1BF" Grid.Column="14" Margin="42,0,0,0" Grid.Row="1" Height="19" CornerRadius="5"/>

                <CheckBox x:Name="chk_Filter_IsSSDP" Grid.Column="11" Content="SSDP UPnP" HorizontalAlignment="Left" VerticalAlignment="Center" IsCheckedChanged="Filter_ScanResults_Explicite" Width="80" Height="15" Grid.Row="1" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="chk_Filter_IsIPCam" Grid.Column="10" Content="Is IP Cam" HorizontalAlignment="Center" VerticalAlignment="Center" IsCheckedChanged="Filter_ScanResults_Explicite" Width="74" Height="15" Grid.Row="1" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="chk_Filter_SupportSMB" Grid.Column="10" Content="SMB" HorizontalAlignment="Center" VerticalAlignment="Center" IsCheckedChanged="Filter_ScanResults_Explicite" Width="74" Height="14"/>
                <CheckBox x:Name="chk_Filter_SupportSNMP" Grid.Column="11" Content="SNMP" HorizontalAlignment="Left" VerticalAlignment="Center" IsCheckedChanged="Filter_ScanResults_Explicite" Width="77" Height="14"/>
                <CheckBox x:Name="chk_Filter_SupportNetBios" Grid.Column="12" Content="NetBios" HorizontalAlignment="Left" VerticalAlignment="Center" IsCheckedChanged="Filter_ScanResults_Explicite" Width="77" Height="14" Grid.Row="1"/>

                <CheckBox x:Name="chk_ScanResults_groupDevices" Grid.Column="13" Content="group devices" HorizontalAlignment="Left" VerticalAlignment="Center" Height="15" Width="96" Margin="5,0,0,0" IsChecked="True" Click="chk_ScanResults_groupDevices_Click"/>
                <CheckBox x:Name="chk_allowDeleteRow" Grid.Column="12" Content="select row" VerticalAlignment="Center" Click="chk_allowDeleteRow_Click" Height="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Margin="0,0,5,0" HorizontalAlignment="Right" Width="73"/>
                <Label Grid.Column="2" Content="&amp;" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Height="23" Width="18"/>
            </Grid>
        </Grid>

        <!-- ======================= UNTEN RECHTS: Methoden-Beschriftungen ======================= -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="171"/>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="126"/>
                <ColumnDefinition Width="113"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="146"/>
                <ColumnDefinition Width="109"/>
                <ColumnDefinition Width="141"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="7" Content="IP / Hostname.domain" Margin="10,0,0,0"/>
            <Label Grid.Column="8" Content="TCP-Ports" Margin="10,-2,10,1"/>
            <Label Content="Methodes to find Device:" Grid.Column="0" Margin="10,0,14,1"/>
            <Label Grid.Column="9" Content="Diff. DNS Server" Margin="10,0,11,0"/>
            <Label Grid.Column="2" Content="Methodes to collect Device Information:" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="rb_ScanHostnames_onlyIPsInTable" Grid.Column="3" Content="only IPs in Table" IsChecked="True" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="rb_ScanHostnames_All_IPs" Grid.Column="4" Content="all" Margin="10,0,0,0" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="31"/>
            <CheckBox x:Name="chk_ShowNotRegisteredHostnames" Grid.Column="5" Content="show not registered hostnames" IsChecked="True" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Height="15" Width="185"/>
        </Grid>

        <Button x:Name="bt_VisualizeTable" Grid.Column="1" Content="Visualize Table Information" HorizontalAlignment="Left" Margin="10,52,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.RowSpan="2" Width="260" Click="bt_VisualizeTable_Click"/>
        <Label Content="Free for personal use" VerticalAlignment="Center" Height="29" VerticalContentAlignment="Center" Foreground="#FF1196A7" HorizontalContentAlignment="Center" FontWeight="Bold" Margin="64,0,65,0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0">
            <TextBlock Text="for commercial contact: " Foreground="#FF1196A7" FontWeight="Bold" VerticalAlignment="Center"/>
            <HyperlinkButton Content="systemswap@tuta.io" NavigateUri="mailto:systemswap@tuta.io" Foreground="#FF1196A7" FontWeight="Bold" Padding="0" VerticalAlignment="Center"/>
        </StackPanel>

        <CheckBox x:Name="chk_3dForceGraph_OnlineVersion" Content="use 3dForceGraph online (means no library is needed when sharing the html file)" Margin="305,54,0,0" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Left" Width="416" Height="18" VerticalAlignment="Top" FontSize="11" VerticalContentAlignment="Center"/>

        <Button x:Name="bt_PayPal" HorizontalAlignment="Center" VerticalAlignment="Center" Width="210" Height="40" Grid.RowSpan="2" Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0" Click="bt_PayPal_Click">
            <Image Source="avares://MyNetworkMonitor.Avalonia/Resources/paypalDonate.png" Stretch="Uniform"/>
        </Button>

        <CheckBox Grid.Column="1" x:Name="chk_dg_Result_ShowEmptyColumns" Content="show empty columns of" IsChecked="True" Margin="0,3,168,0" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="155" Click="chk_dg_Result_ShowEmptyColumns_Click"/>
        <TextBlock x:Name="rowCountTextBlock" Grid.Column="1" Margin="0,2,10,0" Grid.Row="2" TextWrapping="Wrap" Text="0 Devices, 0 filtered" VerticalAlignment="Top" HorizontalAlignment="Right" Width="153" TextAlignment="Left"/>
    </Grid>
</Window>

