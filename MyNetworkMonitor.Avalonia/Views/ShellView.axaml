<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyNetworkMonitor.Core.ViewModels;assembly=MyNetworkMonitor.Core"
        xmlns:model="clr-namespace:MyNetworkMonitor.Core.Model;assembly=MyNetworkMonitor.Core"
        xmlns:net="clr-namespace:MyNetworkMonitor.Core.Network;assembly=MyNetworkMonitor.Core"
        xmlns:conv="clr-namespace:MyNetworkMonitor.Avalonia.Views"
        x:Class="MyNetworkMonitor.Avalonia.Views.ShellView"
        x:Name="ShellRoot"
        x:DataType="vm:ShellViewModel"
        x:CompileBindings="False"
        Title="My Network Monitor"
        Width="1480" Height="880" MinWidth="1180" MinHeight="700"
        FontFamily="Segoe UI" FontSize="12">

  <!--
      Die neue Oberflaeche nach dem abgestimmten Entwurf.

      Aufbau: Kommandobalken oben ueber allem, Navigationsleiste links,
      Arbeitsbereich aus Tabelle und Detailpanel, Statusleiste unten. Die
      Verfahren-Schublade klappt unter dem Kommandobalken auf, statt eine
      eigene Seite zu sein - so bleibt der haeufigste Ablauf ein Klick.

      Farbe traegt Bedeutung: Tuerkis steht fuer IPv4 und ist zugleich die
      Produktfarbe, Indigo durchgehend fuer IPv6. Man erkennt am Farbton,
      welche Protokollwelt man ansieht, ohne ein Label zu lesen.

      Die kompakten Steuerelementmasse aus dem bisherigen Fenster bleiben:
      Fluent dimensioniert deutlich groesser (MinHeight 32, FontSize 14), was
      hier ueberall zurueckgesetzt wird.
  -->

  <Window.Resources>
    <!-- Grundfarben -->
    <SolidColorBrush x:Key="Chrome"      Color="#17272B"/>
    <SolidColorBrush x:Key="Chrome2"     Color="#1F343A"/>
    <SolidColorBrush x:Key="Rail"        Color="#121E21"/>
    <SolidColorBrush x:Key="RailActive"  Color="#1B2F34"/>
    <SolidColorBrush x:Key="Workspace"   Color="#EEF3F3"/>
    <SolidColorBrush x:Key="Panel"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelAlt"    Color="#F7FAFA"/>
    <SolidColorBrush x:Key="Line"        Color="#D3DFE0"/>
    <SolidColorBrush x:Key="LineSoft"    Color="#EDF2F3"/>
    <SolidColorBrush x:Key="Ink"         Color="#142326"/>
    <SolidColorBrush x:Key="Dim"         Color="#6C8085"/>
    <SolidColorBrush x:Key="Dimmer"      Color="#93A5A9"/>

    <!-- Bedeutungstragende Farben -->
    <SolidColorBrush x:Key="Teal"        Color="#0B7C8B"/>
    <SolidColorBrush x:Key="TealSoft"    Color="#DDEFF1"/>
    <SolidColorBrush x:Key="V6"          Color="#5A4FCF"/>
    <SolidColorBrush x:Key="V6Soft"      Color="#E9E6FA"/>
    <SolidColorBrush x:Key="Go"          Color="#17A38A"/>
    <SolidColorBrush x:Key="Ok"          Color="#2C7F51"/>
    <SolidColorBrush x:Key="Warn"        Color="#A66A12"/>
    <SolidColorBrush x:Key="Crit"        Color="#AF382F"/>
    <SolidColorBrush x:Key="CritSoft"    Color="#FADEDB"/>

    <!-- Konverter: sie tragen die Farbregel des Entwurfs -->
    <conv:OnlineBrushConverter x:Key="OnlineBrush"/>
    <conv:Ipv4BrushConverter x:Key="V4Brush"/>
    <conv:Ipv6BrushConverter x:Key="V6Brush"/>
    <conv:MissingStyleConverter x:Key="MissingStyle"/>
    <conv:FamilyBrushConverter x:Key="FamilyBrush"/>
    <conv:IidVisibleConverter x:Key="IidVisible"/>
    <conv:PortStatusTextConverter x:Key="StatusText"/>
    <conv:PortStatusBackgroundConverter x:Key="StatusBg"/>
    <conv:PortStatusForegroundConverter x:Key="StatusFg"/>
    <conv:ConflictLabelConverter x:Key="DupLabel"/>
    <conv:ConflictBackgroundConverter x:Key="DupBg"/>
    <conv:ConflictForegroundConverter x:Key="DupFg"/>
    <conv:DnsCountBrushConverter x:Key="DnsCountBrush"/>
    <conv:CertificateExpiryBrushConverter x:Key="ExpiryBrush"/>
    <conv:SeverityBackgroundConverter x:Key="SeverityBg"/>
    <conv:SeverityForegroundConverter x:Key="SeverityFg"/>
  </Window.Resources>

  <Window.Styles>
    <!-- Kompakte Masse: Fluent klemmt sonst alles auf MinHeight 32 hoch. -->
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="6,0,0,0"/>
    </Style>

    <!--
        Die Fluent-Vorlage deckelt jedes Ausklappmenue auf eine feste Breite
        und steckt seinen Inhalt in einen ScrollViewer. Ein Menue, das breiter
        sein will, waechst darum nicht - es bekommt einen Bildlaufbalken, und
        was rechts steht, verschwindet. Genau das traf die Bereichsauswahl:
        die Spalte "Description" war abgeschnitten und die Knoepfe oben rechts
        gar nicht zu sehen.

        Die Grenze wird hier aufgehoben; die Menues setzen sich ihre eigene
        ueber MaxWidth, damit sie das Fenster nicht verlassen.
    -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="MaxWidth" Value="4000"/>
      <Setter Property="MaxHeight" Value="2000"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="FlyoutPresenter /template/ ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Kommandobalken: dunkle Schaltflaechen -->
    <Style Selector="Button.cmd">
      <Setter Property="Background" Value="#29424A"/>
      <Setter Property="Foreground" Value="#DCE9EB"/>
      <Setter Property="BorderBrush" Value="#3A5860"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.cmd:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33505A"/>
      <Setter Property="BorderBrush" Value="#4A6B75"/>
    </Style>

    <!--
        Eine Schaltflaeche, die wie die ComboBox daneben aussieht. Noetig, weil
        die Bereichsauswahl mehrere Haken zugleich haelt und beim Anhaken offen
        bleiben muss - eine echte ComboBox schliesst sich beim ersten Klick.
    -->
    <Style Selector="Button.combo">
      <Setter Property="Background" Value="#233A41"/>
      <Setter Property="Foreground" Value="#DCE9EB"/>
      <Setter Property="BorderBrush" Value="#3A5860"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style Selector="Button.combo:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2C4750"/>
      <Setter Property="BorderBrush" Value="#4A6B75"/>
    </Style>

    <Style Selector="Button.go">
      <Setter Property="Background" Value="#17A38A"/>
      <Setter Property="Foreground" Value="#04231D"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.go:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1DBB9E"/>
    </Style>
    <Style Selector="Button.go:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B4149"/>
      <Setter Property="Foreground" Value="#6C8085"/>
    </Style>

    <Style Selector="ToggleButton.cmd">
      <Setter Property="Background" Value="#29424A"/>
      <Setter Property="Foreground" Value="#DCE9EB"/>
      <Setter Property="BorderBrush" Value="#3A5860"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ToggleButton.cmd:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#0B7C8B"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Beschriftungen im Kommandobalken -->
    <Style Selector="TextBlock.cmdLabel">
      <Setter Property="Foreground" Value="#7E979C"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0,2,0"/>
    </Style>

    <!-- Navigationsleiste -->
    <Style Selector="RadioButton.nav">
      <Setter Property="Foreground" Value="#8DA5AA"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="NavBorder" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="2,0,0,0"
                  Padding="10,6">
            <ContentPresenter Content="{TemplateBinding Content}"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#NavBorder">
      <Setter Property="Background" Value="#182A2E"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#NavBorder">
      <Setter Property="Background" Value="#1B2F34"/>
      <Setter Property="BorderBrush" Value="#17A38A"/>
    </Style>
    <Style Selector="RadioButton.nav:checked">
      <Setter Property="Foreground" Value="#E6F2F3"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.navGroup">
      <Setter Property="Foreground" Value="#4C6469"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Margin" Value="12,10,0,3"/>
    </Style>

    <!-- Ergebnistabelle: WPF-nahe Zeilenhoehe statt Fluent-Grosszuegigkeit -->
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F3"/>
      <Setter Property="RowBackground" Value="White"/>
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="30"/>
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="#E6EDEE"/>
      <Setter Property="Foreground" Value="#55696D"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="SeparatorBrush" Value="#D3DFE0"/>
    </Style>

    <!-- Abschnittsueberschrift im Detailpanel -->
    <Style Selector=":is(TextBlock).sectionHead">
      <Setter Property="FontSize" Value="9.5"/>
      <Setter Property="Foreground" Value="#7E9095"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style Selector=":is(TextBlock).kvKey">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#7E9095"/>
    </Style>
    <Style Selector=":is(TextBlock).kvValue">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#223438"/>
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace"/>
    </Style>

    <!--
        Im Detailpanel laesst sich jeder Wert markieren und kopieren. Eine
        MAC-Adresse abzuschreiben, weil man sie nur ansehen darf, ist genau
        die Art Reibung, die eine Oberflaeche vermeiden soll.

        Das Kontextmenue kommt an alle SelectableTextBlock auf einmal - an
        siebenunddreissig Stellen einzeln waere es beim naechsten neuen Feld
        vergessen.
    -->
    <Style Selector="SelectableTextBlock">
      <Setter Property="Cursor" Value="Ibeam"/>
      <Setter Property="ContextFlyout">
        <MenuFlyout>
          <MenuItem Header="Copy" Command="{Binding $parent[SelectableTextBlock].Copy}"/>
          <MenuItem Header="Select all" Command="{Binding $parent[SelectableTextBlock].SelectAll}"/>
        </MenuFlyout>
      </Setter>
    </Style>

    <!-- Einstellungsseite -->
    <Style Selector="TextBlock.settingsHead">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0B7C8B"/>
    </Style>

    <Style Selector="TextBlock.settingLabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#142326"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
        Der erklaerende Satz unter jeder Einstellung. Bewusst schmal gehalten,
        damit er sich als Beiwerk liest und nicht mit der Einstellung selbst
        um Aufmerksamkeit streitet.
    -->
    <Style Selector="TextBlock.settingHint">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#7E9095"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="460"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="ScrollViewer#view_Settings CheckBox">
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Fluent gibt dem Schieberegler sonst 32 Pixel Hoehe -->
    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="22"/>
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- ================= KOMMANDOBALKEN ================= -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Chrome2}"
            BorderBrush="#0F1C1F" BorderThickness="0,0,0,1">
      <StackPanel>

        <!-- Zeile: Quelle, Umfang, Start, Fortschritt -->
        <Grid Margin="10,7" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

          <TextBlock Grid.Column="0" Classes="cmdLabel" Text="SOURCE" Margin="0,0,4,0"/>

          <!--
              Mehrfachauswahl mit Kaestchen, an der Stelle der frueheren
              Einzel-IP. Sieht aus wie die Umfangsauswahl daneben und
              verhaelt sich auch so - nur bleibt sie beim Anhaken offen,
              was eine echte ComboBox nicht kann.

              Aufgeklappt steht je Bereich, was ihn ausmacht: von/bis und
              wozu er gehoert. Der Name allein ("Buero 2. OG") sagt nicht,
              welche Adressen gescannt werden.
          -->
          <Button Grid.Column="1" x:Name="bt_Scopes" Classes="combo" MinWidth="280"
                  HorizontalContentAlignment="Left">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding ScopeSummary}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1" Text="▾" FontSize="9" Foreground="#7A959B"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <!--
                    Keine feste Breite: die Tabelle darunter misst ihre Spalten
                    am Inhalt, und der Rahmen richtet sich danach. MaxWidth
                    deckelt das am Fenster, damit ein Bereich mit sehr langer
                    Beschreibung das Menue nicht ueber den Bildschirmrand
                    hinaus zieht.
                -->
                <!--
                    Keine Breitenangabe: das Grid darin misst sich an seinem
                    Inhalt, und der Rahmen folgt. Die Obergrenze setzt
                    BuildScopeRows anhand der Fensterbreite - gebunden liesse
                    sie sich hier nicht, weil das Popup einen eigenen
                    Namensraum hat und #ShellRoot darin nicht aufloest.
                -->
                <Border x:Name="bd_ScopeFlyout" MinWidth="620"
                        Background="{StaticResource Panel}" CornerRadius="4">
                  <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Top">
                      <Border Background="#F6F9F9"
                              BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                              Padding="11,7">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Grid.Column="0" Text="RANGES TO SCAN"
                                     FontSize="9" Foreground="{StaticResource Dim}"
                                     VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="bt_ScopesAll" Content="All" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource Teal}"
                                    FontSize="10.5" Padding="2,0" Click="bt_ScopesAll_Click"/>
                            <Button x:Name="bt_ScopesNone" Content="None" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource Teal}"
                                    FontSize="10.5" Padding="2,0" Click="bt_ScopesNone_Click"/>
                            <Button x:Name="bt_ManageScopes" Content="Manage →" Background="Transparent"
                                    BorderThickness="0" Foreground="{StaticResource Teal}"
                                    FontSize="10.5" Padding="2,0" Click="bt_ManageScopes_Click"/>
                          </StackPanel>
                        </Grid>
                      </Border>

                    </StackPanel>

                    <!--
                        Eigene Eingabe. Sie wirkt zusaetzlich zu den Haken -
                        und ist, wenn keiner gesetzt ist, die ganze Auswahl.
                        Ohne sie liesse sich nichts nachsehen, ohne erst
                        einen Bereich anzulegen.
                    -->
                    <Border DockPanel.Dock="Bottom" Background="#F6F9F9"
                            BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0"
                            Padding="11,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="OWN ENTRY" FontSize="9" Foreground="{StaticResource Dim}"/>
                        <TextBox x:Name="tb_CustomTargets" Height="24" FontSize="11"
                                 Watermark="192.168.1.1-254 · 10.0.0.5 · 192.168.0.0/24 · host.local"
                                 Text="{Binding CustomTargets}"/>
                        <TextBlock x:Name="tb_CustomProblem" FontSize="9.5"
                                   Foreground="{StaticResource Crit}"
                                   Text="{Binding CustomTargetsProblem}"
                                   IsVisible="{Binding CustomTargetsProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock x:Name="tb_ScopeFooter" FontSize="10"
                                   Foreground="{StaticResource Dim}" Classes="mono"/>
                      </StackPanel>
                    </Border>

                    <!--
                        Ein gewoehnliches Grid mit Auto-Spalten statt eines
                        DataGrid. Der Unterschied ist genau der, auf den es
                        hier ankommt: ein Grid misst sich an seinem Inhalt und
                        laesst den Rahmen darum mitwachsen, ein DataGrid nimmt
                        den angebotenen Platz und scrollt intern, wenn er nicht
                        reicht - der Rahmen erfaehrt nie, dass er zu schmal ist.

                        Die Zeilen entstehen in BuildScopeRows, weil ihre Zahl
                        von den vorhandenen Bereichen abhaengt.
                    -->
                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                      <Grid x:Name="grd_Scopes" Margin="0,2"/>
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>

          <TextBlock Grid.Column="2" Classes="cmdLabel" Text="SCOPE"/>

          <ComboBox Grid.Column="3" x:Name="cb_Profile" MinWidth="120"
                    ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfile}"
                    SelectionChanged="cb_Profile_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ScanProfile">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ToggleButton Grid.Column="4" x:Name="tg_Drawer" Classes="cmd" Margin="6,0,0,0"
                        IsChecked="{Binding IsDrawerOpen}">
            <TextBlock>
              <Run Text="Methods"/>
              <Run Text="{Binding SelectedMethodCount, StringFormat=({0})}"/>
            </TextBlock>
          </ToggleButton>

          <Button Grid.Column="5" x:Name="bt_Start" Classes="go" Margin="10,0,0,0"
                  Content="▶  Start scan"
                  Command="{Binding StartCommand}"
                  IsEnabled="{Binding CanStart}"/>

          <Button Grid.Column="6" x:Name="bt_Stop" Classes="cmd" Margin="4,0,0,0"
                  Content="■" Width="28"
                  Command="{Binding StopCommand}"
                  IsEnabled="{Binding IsRunning}"/>

          <!-- Fortschritt: nur waehrend eines Laufs sichtbar -->
          <Grid Grid.Column="7" Margin="14,0" ColumnDefinitions="Auto,*,Auto"
                IsVisible="{Binding IsRunning}" VerticalAlignment="Center">
            <TextBlock Grid.Column="0" Text="{Binding CurrentMethodName}"
                       Foreground="#9CD9C9" FontSize="10.5" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1"
                         Value="{Binding ProgressFraction}" Height="4"
                         Background="#2A4048" Foreground="#17A38A"
                         VerticalAlignment="Center"/>
            <!-- Gesendet / geantwortet / gesamt. Die mittlere Zahl ist die
                 eigentliche Nachricht und darum hervorgehoben; an ihr sieht
                 man, dass ein Lauf noch etwas bringt, waehrend die erste
                 laengst am Ende steht. -->
            <TextBlock Grid.Column="2" Classes="mono" FontSize="10" Foreground="#93ADB2"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       ToolTip.Tip="Sent / answered / total">
              <Run Text="{Binding ProgressCurrent}"/><Run Text=" / "/><Run
                   Text="{Binding ProgressResponded}" Foreground="#9CD9C9"/><Run Text=" / "/><Run
                   Text="{Binding ProgressTotal}"/>
            </TextBlock>
          </Grid>

          <!-- Platz fuer den kuenftigen Dauerbetrieb (RA-/MLD-Listener) -->
          <Border Grid.Column="8" Background="#243940" BorderBrush="#33505A" BorderThickness="1"
                  CornerRadius="3" Padding="9,0" Height="22" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="#4C6469"/>
              <TextBlock Text="Watch off" Foreground="#7E979C" FontSize="10.5"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ================= VERFAHREN-SCHUBLADE ================= -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="12,9"
                IsVisible="{Binding IsDrawerOpen}">
          <Grid ColumnDefinitions="*,*,*,*">

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="DISCOVER DEVICES" Classes="sectionHead"/>
              <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,0,0,6"/>
              <ItemsControl x:Name="ic_Discovery"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
              <TextBlock Text="IDENTIFY DEVICE" Classes="sectionHead"/>
              <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,0,0,6"/>
              <!-- Der DNS-Quervergleich haengt als Unterfunktion mitten in
                   dieser Liste, zwischen Rueckwaertsaufloesung und Hostname.
                   Eingesetzt wird er in BuildMethodDrawer. -->
              <ItemsControl x:Name="ic_Identification"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,12,0">
              <TextBlock Text="CHECK SERVICES" Classes="sectionHead"/>
              <Border Height="1" Background="{StaticResource LineSoft}" Margin="0,0,0,6"/>
              <ItemsControl x:Name="ic_Services"/>
            </StackPanel>

            <StackPanel Grid.Column="3">
              <TextBlock Text="IPV6" Classes="sectionHead" Foreground="{StaticResource V6}"/>
              <Border Height="1" Background="#D6D0F5" Margin="0,0,0,6"/>
              <ItemsControl x:Name="ic_Ipv6"/>
              <TextBlock x:Name="tb_Ipv6Hint" FontSize="10" Foreground="{StaticResource Dimmer}"
                         TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- ================= STATUSLEISTE ================= -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome2}"
            BorderBrush="#0F1C1F" BorderThickness="0,1,0,0">
      <StackPanel>

        <!--
            Was fertig ist und was noch kommt. Ein Lauf besteht aus mehreren
            Verfahren nacheinander; ohne diese Zeile sieht man nur das gerade
            laufende und weiss nicht, ob nach ARP noch eine halbe Stunde
            Diensterkennung folgt.
        -->
        <Border Background="#1A2C32" BorderBrush="#0F1C1F" BorderThickness="0,1,0,0"
                Padding="10,3" IsVisible="{Binding HasScanPlan}">
          <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock FontSize="10.5" Foreground="#7E979C" VerticalAlignment="Center">
              <Run Text="done: "/><Run Text="{Binding CompletedScansText}" Foreground="#5FCBAE"/>
            </TextBlock>
            <TextBlock FontSize="10.5" Foreground="#7E979C" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis">
              <Run Text="pending: "/><Run Text="{Binding PendingScansText}" Foreground="#D3E4E6"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <Grid Margin="10,0" Height="26" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <TextBlock Classes="mono" FontSize="10.5" Foreground="#93ADB2">
              <Run Text="{Binding Devices.TotalCount}" Foreground="#D3E4E6"/><Run Text=" devices"/>
            </TextBlock>
            <TextBlock Classes="mono" FontSize="10.5" Foreground="#93ADB2">
              <Run Text="{Binding Devices.FilteredOutCount}" Foreground="#D3E4E6"/><Run Text=" filtered out"/>
            </TextBlock>
            <TextBlock Classes="mono" FontSize="10.5" Foreground="#93ADB2">
              <Run Text="IPv6-capable "/><Run Text="{Binding Devices.Ipv6CapableCount}" Foreground="#9186F5"/>
            </TextBlock>
            <TextBlock Classes="mono" FontSize="10.5" Foreground="#93ADB2">
              <Run Text="reachable "/><Run Text="{Binding Devices.OnlineCount}" Foreground="#D3E4E6"/>
            </TextBlock>
          </StackPanel>

          <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10.5"
                     Foreground="#93ADB2" VerticalAlignment="Center"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="bt_Export" Classes="cmd" Content="Export" Height="19" FontSize="10"
                    Click="bt_Export_Click"/>
            <Button x:Name="bt_Clear" Classes="cmd" Content="Clear" Height="19" FontSize="10"
                    Command="{Binding ClearResultsCommand}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ================= RAIL + ARBEITSBEREICH ================= -->
    <Grid ColumnDefinitions="136,*">

      <Border Grid.Column="0" Background="{StaticResource Rail}">
        <StackPanel Margin="0,8">
          <RadioButton x:Name="nav_Devices" Classes="nav" GroupName="nav" IsChecked="True"
                       Content="▤   Devices" IsCheckedChanged="Nav_Checked" Tag="Devices"/>
          <RadioButton x:Name="nav_Network" Classes="nav" GroupName="nav"
                       Content="◈   Network" IsCheckedChanged="Nav_Checked" Tag="Network"/>
          <RadioButton x:Name="nav_Findings" Classes="nav" GroupName="nav"
                       Content="⚠   Findings" IsCheckedChanged="Nav_Checked" Tag="Findings"/>
          <RadioButton x:Name="nav_Topology" Classes="nav" GroupName="nav"
                       Content="⬡   Topology" IsCheckedChanged="Nav_Checked" Tag="Topology"/>

          <Border Height="1" Background="#1E2E32" Margin="12,8"/>
          <TextBlock Text="MANAGE" Classes="navGroup"/>

          <RadioButton x:Name="nav_Scopes" Classes="nav" GroupName="nav"
                       Content="≡   Ranges" IsCheckedChanged="Nav_Checked" Tag="Scopes"/>
          <RadioButton x:Name="nav_Ports" Classes="nav" GroupName="nav"
                       Content="⋮   Ports" IsCheckedChanged="Nav_Checked" Tag="Ports"/>
          <RadioButton x:Name="nav_Services" Classes="nav" GroupName="nav"
                       Content="◇   Services" IsCheckedChanged="Nav_Checked" Tag="Services"/>
          <RadioButton x:Name="nav_Satellites" Classes="nav" GroupName="nav"
                       Content="◎   Satellites" IsCheckedChanged="Nav_Checked" Tag="Satellites"/>
          <RadioButton x:Name="nav_Names" Classes="nav" GroupName="nav"
                       Content="✎   Names" IsCheckedChanged="Nav_Checked" Tag="Names"/>

          <Border Height="1" Background="#1E2E32" Margin="12,8"/>
          <RadioButton x:Name="nav_Settings" Classes="nav" GroupName="nav"
                       Content="⚙   Settings" IsCheckedChanged="Nav_Checked" Tag="Settings"/>
        </StackPanel>
      </Border>

      <!-- Arbeitsbereich -->
      <Grid Grid.Column="1" Background="{StaticResource Workspace}">

        <!-- ========== Ansicht: Geraete ========== -->
        <DockPanel x:Name="view_Devices" LastChildFill="True">

          <!-- Filterzeile -->
          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

              <TextBox Grid.Column="0" x:Name="tb_Search" Width="190" Watermark="Search across all columns"
                       Text="{Binding Devices.Filter.Text1}"/>

              <TextBox Grid.Column="1" x:Name="tb_Search2" Width="120" Margin="4,0,0,0"
                       Watermark="and ..." Text="{Binding Devices.Filter.Text2}"/>

              <!-- Dienstauswahl: entsteht aus den tatsaechlichen Funden -->
              <Button Grid.Column="2" x:Name="bt_ServiceFilter" Margin="8,0,0,0" MinWidth="106"
                      HorizontalContentAlignment="Left"
                      Background="White" BorderBrush="#C3D2D4" BorderThickness="1">
                <TextBlock x:Name="tb_ServiceFilterLabel" Text="Service  ▾" FontSize="10.5"
                           Foreground="#47595D"/>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <Border Width="270" Background="{StaticResource Panel}">
                      <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Padding="10,6" Background="#F6F9F9"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="*,Auto">
                            <CheckBox Grid.Column="0" Content="only running" FontSize="10.5"
                                      IsChecked="{Binding Devices.Filter.OnlyRunningServices}"/>
                            <Button Grid.Column="1" x:Name="bt_ServicesNone" Content="None"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Teal}" FontSize="10.5"
                                    Click="bt_ServicesNone_Click"/>
                          </Grid>
                        </Border>
                        <!-- Ohne den Roller endet die Liste bei der Hoehe der
                             Flyouts, und die Dienste darunter sind weder zu
                             sehen noch anzuhaken. -->
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl x:Name="ic_ServiceFacets" Margin="0,3"/>
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!-- Bereichsauswahl: entsteht aus den Bereichen, aus denen die
                   gefundenen Geraete stammen - nicht aus einer festen Liste,
                   weil sich die Bereiche je nach Arbeitsort aendern. -->
              <Button Grid.Column="3" x:Name="bt_ScopeFilter" Margin="4,0,0,0" MinWidth="100"
                      HorizontalContentAlignment="Left"
                      Background="White" BorderBrush="#C3D2D4" BorderThickness="1">
                <TextBlock x:Name="tb_ScopeFilterLabel" Text="Range  ▾" FontSize="10.5"
                           Foreground="#47595D"/>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <Border Width="270" Background="{StaticResource Panel}">
                      <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Padding="10,6" Background="#F6F9F9"
                                BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Scanned ranges" FontSize="10.5"
                                       Foreground="#47595D" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="bt_RangeFilterNone" Content="None"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource Teal}" FontSize="10.5"
                                    Click="bt_RangeFilterNone_Click"/>
                          </Grid>
                        </Border>
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl x:Name="ic_ScopeFacets" Margin="0,3"/>
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <TextBox Grid.Column="4" x:Name="tb_PortFilter" Width="96" Margin="4,0,0,0"
                       Watermark="Port" ToolTip.Tip="445 · 80,443 · 5000-5100"
                       Text="{Binding Devices.Filter.Ports}"/>

              <!-- Familienschalter: Tuerkis fuer v4, Indigo fuer v6 -->
              <ToggleButton Grid.Column="5" x:Name="tg_V4" Margin="8,0,0,0"
                            IsChecked="{Binding Devices.Filter.ShowIPv4}"
                            Background="{StaticResource TealSoft}" BorderBrush="#77BAC3"
                            BorderThickness="1" Foreground="#08606C" FontSize="10.5"
                            Content="IPv4"/>

              <ToggleButton Grid.Column="6" x:Name="tg_V6" Margin="4,0,0,0"
                            IsChecked="{Binding Devices.Filter.ShowIPv6}"
                            Background="{StaticResource V6Soft}" BorderBrush="#A79FEA"
                            BorderThickness="1" Foreground="#4A3FC0" FontSize="10.5"
                            Content="IPv6"/>

              <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="10" Margin="12,0,0,0"
                          VerticalAlignment="Center">
                <CheckBox Content="only reachable" FontSize="10.5"
                          IsChecked="{Binding Devices.Filter.OnlyOnline}"/>
                <CheckBox Content="globally reachable" FontSize="10.5"
                          Foreground="{StaticResource V6}"
                          ToolTip.Tip="Only devices with a global IPv6 address - reachable from the internet without NAT"
                          IsChecked="{Binding Devices.Filter.OnlyGloballyReachable}"/>
                <CheckBox Content="duplicates only" FontSize="10.5"
                          Foreground="{StaticResource Crit}"
                          ToolTip.Tip="Only devices whose address or name is assigned more than once"
                          IsChecked="{Binding Devices.Filter.OnlyConflicts}"/>
                <CheckBox Content="duplicates first" FontSize="10.5"
                          Foreground="{StaticResource Crit}"
                          ToolTip.Tip="Sort conflicting devices to the top instead of hiding the rest"
                          IsChecked="{Binding Devices.ConflictsFirst}"/>
              </StackPanel>

              <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6">
                <Button x:Name="bt_ResetFilter" Content="Reset filters" FontSize="10.5"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                        Click="bt_ResetFilter_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Tabelle und Detailpanel -->
          <Grid ColumnDefinitions="*,4,340">

            <DataGrid Grid.Column="0" x:Name="dg_Devices"
                      ItemsSource="{Binding Devices.Visible}"
                      SelectedItem="{Binding Devices.Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserResizeColumns="True" SelectionMode="Extended"
                      SelectionChanged="dg_Devices_SelectionChanged">
              <!--
                  Erneut scannen gehoert an die Zeile, nicht nur in den
                  Kommandobalken: wer ein einzelnes Geraet nachprueft, will
                  nicht das halbe Netz noch einmal abfragen.
              -->
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Rescan selected devices"
                            Command="{Binding RescanSelectedCommand}"/>

                  <Separator/>

                  <!-- Die Dienstliste entsteht im Code: sie kommt aus der
                       Aufzaehlung der Dienste, und jeder Eintrag muss seinen
                       Dienst als Parameter mitgeben. -->
                  <MenuItem x:Name="mi_FindServicePort"
                            Header="Find port of one service (all 65536 ports)"
                            ToolTip.Tip="Searches the whole port range for a single service - for a service that runs on an unusual port and is therefore never found by the regular scan. Takes a while, so it runs for one device at a time."/>

                  <MenuItem Header="Resolve IP across DNS servers"
                            Command="{Binding ResolveAcrossDnsServersCommand}"
                            ToolTip.Tip="Asks every known DNS server about this address separately, forwards and backwards. If they disagree, that is the finding - and it names the server."/>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>

                <DataGridTemplateColumn Header="" Width="26">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="model:Device">
                      <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Doppelbelegung. Steht direkt neben dem Namen, weil sie
                     genau dort interessiert: der Name sieht harmlos aus, und
                     erst das Kaestchen sagt, dass es ihn zweimal gibt. -->
                <DataGridTemplateColumn Header="!" Width="Auto" MinWidth="62">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="model:Device">
                      <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                              IsVisible="{Binding HasConflict}"
                              Background="{Binding Conflicts, Converter={StaticResource DupBg}}"
                              ToolTip.Tip="{Binding ConflictDetails}">
                        <TextBlock Text="{Binding Conflicts, Converter={StaticResource DupLabel}}"
                                   FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{Binding Conflicts, Converter={StaticResource DupFg}}"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="DEVICE" Width="Auto" MinWidth="130">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="model:Device">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5"/>
                        <TextBlock Text="{Binding GroupDescription}" FontSize="9.5"
                                   Foreground="{StaticResource Dimmer}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="IPV4" Width="Auto" MinWidth="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="model:Device">
                      <TextBlock Classes="mono" FontSize="10.5" VerticalAlignment="Center"
                                 Text="{Binding Ipv4Text}"
                                 Foreground="{Binding HasIpv4, Converter={StaticResource V4Brush}}"
                                 FontStyle="{Binding HasIpv4, Converter={StaticResource MissingStyle}}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="IPV6" Width="Auto" MinWidth="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="model:Device">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Classes="mono" FontSize="10.5"
                                   Text="{Binding Ipv6Text}"
                                   Foreground="{Binding HasIpv6, Converter={StaticResource V6Brush}}"
                                   FontStyle="{Binding HasIpv6, Converter={StaticResource MissingStyle}}"/>
                        <Border Background="{StaticResource V6Soft}" CornerRadius="3" Padding="4,0"
                                IsVisible="{Binding Ipv6ExtraText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Text="{Binding Ipv6ExtraText}" Classes="mono" FontSize="9"
                                     Foreground="#4A3FC0"/>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="VENDOR" Binding="{Binding Vendor}" Width="Auto" MinWidth="90"/>

                <!--
                    Die laufenden Dienste als Kaestchen statt als Fliesstext -
                    so liest man auf einen Blick, was auf einem Geraet
                    tatsaechlich antwortet. Wurde nichts erkannt, bleibt die
                    Zelle leer; ein "keine erkannt" in jeder Zeile waere
                    Rauschen, das die wenigen Funde erschlaegt.
                -->
                <DataGridTemplateColumn Header="RUNNING SERVICES" Width="Auto" MinWidth="170">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="model:Device">
                      <ItemsControl ItemsSource="{Binding ServiceChips}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="3"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource TealSoft}" BorderBrush="#A9D5DB"
                                    BorderThickness="1" CornerRadius="3" Padding="5,1">
                              <TextBlock Text="{Binding}" FontSize="9.5" Foreground="#08606C"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="PORTS" Binding="{Binding OpenPortCount}" Width="Auto"/>

                <DataGridTextColumn Header="SEEN" Binding="{Binding LastSeenText}" Width="Auto"/>
              </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Background="{StaticResource Line}" Width="4"
                          ResizeDirection="Columns"/>

            <!-- ========== Detailpanel ========== -->
            <Border Grid.Column="2" Background="{StaticResource PanelAlt}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">

              <!-- Ohne Auswahl ein Hinweis statt eines leeren Kastens -->
              <Panel>
                <TextBlock Text="Select a row to see details"
                           Foreground="{StaticResource Dimmer}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding Devices.Selected, Converter={x:Static ObjectConverters.IsNull}}"/>

                <!--
                    Sichtbarkeit und DataContext duerfen nicht am selben
                    Element haengen: sobald der DataContext auf die Auswahl
                    (und damit auf null) zeigt, laesst sich der Pfad
                    Devices.Selected der Sichtbarkeitsbindung nicht mehr
                    aufloesen - die Bindung scheitert still und der Abschnitt
                    bleibt sichtbar. Darum die Sichtbarkeit eine Ebene hoeher.
                -->
                <Border IsVisible="{Binding Devices.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer DataContext="{Binding Devices.Selected}">
                  <StackPanel>

                    <!-- Kopf -->
                    <Border Background="{StaticResource Panel}" Padding="12,10"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                   Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"/>
                          <SelectableTextBlock Text="{Binding DisplayName}" FontSize="13.5"
                                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <SelectableTextBlock Classes="mono" FontSize="10" Foreground="{StaticResource Dim}"
                                   TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Vendor}"/><Run Text=" · "/><Run Text="{Binding MacText}"/>
                        </SelectableTextBlock>
                      </StackPanel>
                    </Border>

                    <!-- Doppelbelegung. Steht vor allem anderen: wenn eine
                         Adresse zweimal vergeben ist, ist das die erste
                         Nachricht, nicht eine Fussnote unter den Diensten. -->
                    <Border Padding="12,9" IsVisible="{Binding HasConflict}"
                            Background="{Binding Conflicts, Converter={StaticResource DupBg}}"
                            BorderBrush="#E3EBEC" BorderThickness="0,0,0,1">
                      <StackPanel Spacing="3">
                        <SelectableTextBlock Text="DUPLICATE ASSIGNMENT" Classes="sectionHead"
                                   Foreground="{Binding Conflicts, Converter={StaticResource DupFg}}"/>
                        <SelectableTextBlock Text="{Binding ConflictDetails}" FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding Conflicts, Converter={StaticResource DupFg}}"/>
                      </StackPanel>
                    </Border>

                    <!-- Was der Namensdienst sagt. Ohne diesen Abschnitt liesse
                         sich ein DNS-Befund oben nicht nachvollziehen. -->
                    <Border Padding="12,9" BorderBrush="#E3EBEC" BorderThickness="0,0,0,1"
                            IsVisible="{Binding WasLookedUp}">
                      <StackPanel>
                        <SelectableTextBlock Text="NAME SERVICE" Classes="sectionHead"/>
                        <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,Auto">
                          <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Resolves to" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LookupAddressText}"
                                     Classes="kvValue" TextWrapping="Wrap"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Aliases" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AliasText}"
                                     Classes="kvValue" TextWrapping="Wrap"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Wo das Geraet steckt. Steht weit oben, weil es die
                         Angabe ist, mit der man tatsaechlich hingehen kann -
                         alles Uebrige beschreibt nur, was es tut. -->
                    <Border Padding="12,9" BorderBrush="#E3EBEC" BorderThickness="0,0,0,1"
                            IsVisible="{Binding HasSwitchInfo}">
                      <StackPanel>
                        <SelectableTextBlock Text="WHERE IT IS PLUGGED IN" Classes="sectionHead"/>
                        <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto">
                          <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Switch" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SwitchName}"
                                     Classes="kvValue" TextWrapping="Wrap"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Port" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SwitchPort}"
                                     Classes="kvValue" TextWrapping="Wrap"/>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="VLAN" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vlan}" Classes="kvValue"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Die Weboberflaeche. Der Seitentitel ist oft die einzige
                         Stelle, an der ein Geraet seinen Modellnamen nennt. -->
                    <Border Padding="12,9" BorderBrush="#E3EBEC" BorderThickness="0,0,0,1"
                            IsVisible="{Binding HasWebInfo}">
                      <StackPanel>
                        <SelectableTextBlock Text="WEB INTERFACE" Classes="sectionHead"/>
                        <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto,Auto">
                          <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Title" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WebTitle}"
                                     Classes="kvValue" TextWrapping="Wrap"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="Certificate" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CertificateSubject}"
                                     Classes="kvValue" TextWrapping="Wrap"/>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Issued by" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CertificateIssuer}"
                                     Classes="kvValue" TextWrapping="Wrap"/>

                          <!-- Abgelaufen wird rot: das ist der Fall, um den es
                               hier ueberhaupt geht. -->
                          <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Valid until" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="kvValue"
                                     Text="{Binding CertificateExpires, StringFormat={}{0:dd.MM.yyyy}}"
                                     Foreground="{Binding CertificateIsExpired, Converter={StaticResource ExpiryBrush}}"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Identitaet -->
                    <Border Padding="12,9" BorderBrush="#E3EBEC" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <SelectableTextBlock Text="IDENTITY" Classes="sectionHead"/>
                        <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                          <SelectableTextBlock Grid.Row="0" Grid.Column="0" Text="Hostname" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HostName}" Classes="kvValue"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="0" Text="MAC" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MacText}" Classes="kvValue"/>

                          <!--
                              Die Vermutung aus der Ping-TTL. Ausdruecklich als
                              "Probably" beschriftet: die Anfangs-TTL laesst
                              sich verstellen, und hinter einem NAT-Gateway kann
                              eine fremde stehen. Als Feststellung waere die
                              Zeile irrefuehrend, als Anhaltspunkt ist sie es
                              nicht - und sie kostet kein einziges Paket.
                          -->
                          <SelectableTextBlock Grid.Row="2" Grid.Column="0" Text="Probably" Classes="kvKey"
                                     IsVisible="{Binding HasOsGuess}"/>
                          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OsGuess}"
                                     Classes="kvValue" TextWrapping="Wrap"
                                     IsVisible="{Binding HasOsGuess}"/>

                          <SelectableTextBlock Grid.Row="3" Grid.Column="0" Text="Identified by" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IdentityKey}" Classes="kvValue"/>
                          <SelectableTextBlock Grid.Row="4" Grid.Column="0" Text="First seen" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="kvValue"
                                     Text="{Binding FirstSeen, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                          <SelectableTextBlock Grid.Row="5" Grid.Column="0" Text="Last seen" Classes="kvKey"/>
                          <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastSeenText}" Classes="kvValue"/>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <!-- Adressen: der Grund, warum es das Panel gibt -->
                    <Border Padding="12,9" BorderBrush="#E3EBEC" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <SelectableTextBlock Text="ADDRESSES" Classes="sectionHead"/>
                          <Border Background="#E1E9EA" CornerRadius="7" Padding="5,0" Height="13"
                                  VerticalAlignment="Top">
                            <SelectableTextBlock Text="{Binding Addresses.Count}" FontSize="8.5"
                                       Foreground="#5C6F73" VerticalAlignment="Center"/>
                          </Border>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Addresses}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:DeviceAddress">
                              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <SelectableTextBlock Grid.Column="0" Classes="mono" FontSize="10"
                                           Text="{Binding Info.Canonical}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{Binding Info.Family, Converter={StaticResource FamilyBrush}}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                  <Border Background="#EDF1F2" CornerRadius="3" Padding="4,0">
                                    <SelectableTextBlock Text="{Binding Info.Scope}" FontSize="8.5"
                                               Foreground="#56696D"/>
                                  </Border>
                                  <Border Background="#EDF1F2" CornerRadius="3" Padding="4,0"
                                          IsVisible="{Binding Info.InterfaceIdKind, Converter={StaticResource IidVisible}}">
                                    <SelectableTextBlock Text="{Binding Info.InterfaceIdKind}" FontSize="8.5"
                                               Foreground="#56696D"/>
                                  </Border>
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <!-- Dienste mit v4/v6 nebeneinander -->
                    <Border Padding="12,9" BorderBrush="#E3EBEC" BorderThickness="0,0,0,1"
                            IsVisible="{Binding HasServices}">
                      <StackPanel>
                        <SelectableTextBlock Text="SERVICES &amp; PORTS" Classes="sectionHead"/>

                        <Grid ColumnDefinitions="*,44,44" Margin="0,0,0,3">
                          <SelectableTextBlock Grid.Column="0" Text="Service" FontSize="8.5"
                                     Foreground="{StaticResource Dimmer}"/>
                          <SelectableTextBlock Grid.Column="1" Text="v4" FontSize="8.5" TextAlignment="Center"
                                     Foreground="{StaticResource Teal}"/>
                          <SelectableTextBlock Grid.Column="2" Text="v6" FontSize="8.5" TextAlignment="Center"
                                     Foreground="{StaticResource V6}"/>
                        </Grid>

                        <!--
                            Nur die Dienste, die geantwortet haben. Gescannt
                            wird gegen mehrere hundert Definitionen - stuenden
                            die geschlossenen mit darin, muesste man die zwei
                            Funde in einer Liste von dreihundert "zu" suchen.
                        -->
                        <ItemsControl ItemsSource="{Binding OpenServices}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:DeviceServiceResult">
                              <Grid ColumnDefinitions="*,44,44" Margin="0,0,0,3">
                                <SelectableTextBlock Grid.Column="0" Classes="mono" FontSize="10"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                  <Run Text="{Binding ServiceName}"/>
                                  <Run Text="{Binding PortsText}" Foreground="#93A5A9"/>
                                </SelectableTextBlock>
                                <Border Grid.Column="1" CornerRadius="3" Margin="2,0" Padding="0,1"
                                        Background="{Binding StatusIPv4, Converter={StaticResource StatusBg}}">
                                  <SelectableTextBlock Text="{Binding StatusIPv4, Converter={StaticResource StatusText}}"
                                             FontSize="8.5" TextAlignment="Center"
                                             Foreground="{Binding StatusIPv4, Converter={StaticResource StatusFg}}"/>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="3" Margin="2,0" Padding="0,1"
                                        Background="{Binding StatusIPv6, Converter={StaticResource StatusBg}}">
                                  <SelectableTextBlock Text="{Binding StatusIPv6, Converter={StaticResource StatusText}}"
                                             FontSize="8.5" TextAlignment="Center"
                                             Foreground="{Binding StatusIPv6, Converter={StaticResource StatusFg}}"/>
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>

                    <!-- Freitext der Module -->
                    <Border Padding="12,9" IsVisible="{Binding HasDetails}">
                      <StackPanel>
                        <SelectableTextBlock Text="MORE DETAILS" Classes="sectionHead"/>
                        <ItemsControl ItemsSource="{Binding Details}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,5">
                                <SelectableTextBlock Text="{Binding Key}" Classes="kvKey"/>
                                <SelectableTextBlock Text="{Binding Value}" Classes="kvValue"
                                           TextWrapping="Wrap" TextTrimming="None"/>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
                </Border>
              </Panel>
            </Border>
          </Grid>
        </DockPanel>

        <!-- ========== Ansicht: Bereiche ========== -->
        <!--
            Liste links, Maske rechts - dieselbe Aufteilung wie im bisherigen
            Fenster, damit niemand umlernen muss. Gespeichert wird nach jeder
            Aenderung; es gibt bewusst keinen Speichern-Knopf.
        -->
        <Grid x:Name="view_Scopes" IsVisible="False" ColumnDefinitions="380,1,*"
              Background="{StaticResource Workspace}">

          <DockPanel Grid.Column="0" Background="{StaticResource Panel}" LastChildFill="True">

            <Border DockPanel.Dock="Top" Background="#F6F9F9"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                    Padding="12,8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="RANGES" Classes="settingsHead"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Content="New" Command="{Binding ScopeEditor.AddCommand}"
                          Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                          FontSize="10.5"/>
                  <Button Content="Duplicate" Command="{Binding ScopeEditor.DuplicateCommand}"
                          IsEnabled="{Binding ScopeEditor.IsEditable}"
                          Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                          FontSize="10.5"/>
                  <Button Content="Delete" Command="{Binding ScopeEditor.DeleteCommand}"
                          IsEnabled="{Binding ScopeEditor.IsEditable}"
                          Background="White" BorderBrush="#E2B6B1" BorderThickness="1"
                          Foreground="{StaticResource Crit}" FontSize="10.5"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#F6F9F9"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                    Padding="12,6">
              <TextBlock Text="{Binding ScopeEditor.Status}" FontSize="10"
                         Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
            </Border>

            <ListBox ItemsSource="{Binding Scopes}"
                     SelectedItem="{Binding ScopeEditor.Selected}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="model:ScanScope">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Include this range in the next scan"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding GroupDescription}" FontSize="12"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding RangeText}" Classes="mono" FontSize="10"
                                 Foreground="{StaticResource Teal}"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Border Grid.Column="1" Background="{StaticResource Line}"/>

          <Panel Grid.Column="2">

            <TextBlock Text="Select a range on the left, or create a new one"
                       Foreground="{StaticResource Dimmer}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !ScopeEditor.HasSelection}"/>

            <ScrollViewer IsVisible="{Binding ScopeEditor.HasSelection}" Padding="20">
              <StackPanel MaxWidth="620" HorizontalAlignment="Left" Spacing="14"
                          DataContext="{Binding ScopeEditor}">

                <!-- Der Adapter-Bereich wird erzeugt, nicht gespeichert -->
                <Border Background="#FFF6E6" BorderBrush="#E8CE9B" BorderThickness="1"
                        CornerRadius="4" Padding="12,9"
                        IsVisible="{Binding !IsEditable}">
                  <TextBlock FontSize="11" Foreground="#7A5A18" TextWrapping="Wrap"
                             Text="This range is derived from the network adapter your machine is actually connected through. It is rebuilt on every start and cannot be edited or deleted."/>
                </Border>

                <Border Background="{StaticResource CritSoft}" BorderBrush="#E2B6B1"
                        BorderThickness="1" CornerRadius="4" Padding="12,8"
                        IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Problem}" FontSize="11"
                             Foreground="{StaticResource Crit}" TextWrapping="Wrap"/>
                </Border>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="16,14"
                        IsEnabled="{Binding IsEditable}">
                  <StackPanel Spacing="11">
                    <TextBlock Text="ADDRESSES" Classes="settingsHead"/>

                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="10" RowSpacing="8">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Classes="settingLabel"/>
                      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Selected.GroupDescription}"
                               Watermark="e.g. Office 2nd floor"/>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" Classes="settingLabel"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Selected.DeviceDescription}"
                               Watermark="What lives here - printers, clients, cameras"/>

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="First IP" Classes="settingLabel"/>
                      <TextBox Grid.Row="2" Grid.Column="1" Classes="mono" Width="190"
                               HorizontalAlignment="Left" Text="{Binding Selected.FirstIP}"/>

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Last IP" Classes="settingLabel"/>
                      <TextBox Grid.Row="3" Grid.Column="1" Classes="mono" Width="190"
                               HorizontalAlignment="Left" Text="{Binding Selected.LastIP}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="16,14"
                        IsEnabled="{Binding IsEditable}">
                  <StackPanel Spacing="11">
                    <TextBlock Text="NAME RESOLUTION" Classes="settingsHead"/>

                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="10" RowSpacing="8">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Domain" Classes="settingLabel"/>
                      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Domain}"
                               Watermark="e.g. company.local"/>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="DNS servers" Classes="settingLabel"/>
                      <TextBox Grid.Row="1" Grid.Column="1" Classes="mono"
                               Text="{Binding Selected.DnsServers}"
                               Watermark="10.0.0.1, 10.0.0.2"/>
                    </Grid>

                    <TextBlock Classes="settingHint"
                               Text="Used to resolve hostnames for this range. Several servers separated by comma. A DNS server set under Settings overrides all of these."/>

                    <!--
                        Ein Name statt einer IP laesst die ganze Liste unter den
                        Tisch fallen - das passiert sonst lautlos, darum steht
                        die Warnung direkt unter dem Feld.
                    -->
                    <Border Background="{StaticResource CritSoft}" CornerRadius="3"
                            Padding="9,6" HorizontalAlignment="Left" MaxWidth="460"
                            IsVisible="{Binding Selected.HasDnsServerWarning}">
                      <TextBlock Text="{Binding Selected.DnsServerWarning}"
                                 FontSize="10.5" TextWrapping="Wrap"
                                 Foreground="{StaticResource Crit}"/>
                    </Border>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="16,14"
                        IsEnabled="{Binding IsEditable}">
                  <StackPanel Spacing="11">
                    <TextBlock Text="NETWORK" Classes="settingsHead"/>

                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto"
                          ColumnSpacing="10">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Gateway" Classes="settingLabel"/>
                      <TextBox Grid.Row="0" Grid.Column="1" Classes="mono" Width="190"
                               HorizontalAlignment="Left" Text="{Binding Selected.GatewayIP}"
                               Watermark="10.0.0.1"/>
                    </Grid>

                    <Border Background="{StaticResource CritSoft}" CornerRadius="3"
                            Padding="9,6" HorizontalAlignment="Left" MaxWidth="460"
                            IsVisible="{Binding Selected.HasGatewayWarning}">
                      <TextBlock Text="{Binding Selected.GatewayWarning}"
                                 FontSize="10.5" TextWrapping="Wrap"
                                 Foreground="{StaticResource Crit}"/>
                    </Border>

                    <TextBlock Classes="settingHint"
                               Text="The router of this network. Used as the reference point for hop distance, for the topology and as the name server of last resort. Leave it empty to use the gateway of the adapter this range is scanned through - that is the normal case."/>

                    <!--
                        Das Feld steht schon hier, obwohl der Satellitenbetrieb
                        noch nicht gebaut ist: der Wert wird bereits gespeichert
                        und mit dem Bereich durchgereicht, und wer seine
                        Bereiche vorbereiten will, kann das tun. Solange kein
                        Satellit verbunden ist, laeuft alles von hier aus.
                        Siehe SATELLIT.md.
                    -->
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto"
                          ColumnSpacing="10">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Scanned by" Classes="settingLabel"/>

                      <!--
                          Auswahl statt Textfeld: ein vertippter Name zeigt auf
                          keinen Satelliten, und der Bereich wuerde beim Lauf
                          als "nicht gescannt" ausgewiesen, ohne dass man den
                          Grund saehe. Der leere Eintrag ganz oben bedeutet
                          "von diesem Rechner aus".
                      -->
                      <ComboBox Grid.Row="0" Grid.Column="1" Width="190"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding SatelliteEditor.NamesForPicker}"
                                SelectedItem="{Binding Selected.ScannedBy}"/>
                    </Grid>

                    <TextBlock Classes="settingHint"
                               Text="The satellite that scans this range - an instance running as a service inside that segment. Empty means this machine does it. Manage the list under Satellites. Not in service yet: the value is kept, but every range is still scanned from here."/>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="16,14"
                        IsEnabled="{Binding IsEditable}">
                  <StackPanel Spacing="9">
                    <TextBlock Text="AUTOMATIC SCAN" Classes="settingsHead"/>

                    <CheckBox Content="Scan this range on a schedule"
                              IsChecked="{Binding Selected.AutomaticScan}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="Every" Classes="settingLabel"/>
                      <TextBox Width="70" Classes="mono"
                               Text="{Binding Selected.ScanIntervalMinutes}"
                               IsEnabled="{Binding Selected.AutomaticScan}"/>
                      <TextBlock Text="minutes" Classes="settingLabel"/>
                    </StackPanel>

                    <TextBlock Classes="settingHint"
                               Text="Stored with the range. The scheduler that acts on it is not built into this window yet."/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </Grid>

        <!-- ========== Ansicht: Ports ========== -->
        <!--
            Eine Tabelle statt einer Maske: hier wird nicht ein Eintrag
            bearbeitet, sondern in Serie abgehakt. Die Knoepfe "all TCP" und
            "none" wirken bewusst nur auf die gefilterten Zeilen - wer nach
            "SQL" sucht und dann alles anhakt, meint die SQL-Ports.
        -->
        <DockPanel x:Name="view_Ports" IsVisible="False" LastChildFill="True"
                   Background="{StaticResource Workspace}">

          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Width="220" Watermark="Search port or description"
                       Text="{Binding PortEditor.Filter}"/>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="TCP" Classes="settingLabel" FontSize="10.5"
                           Foreground="{StaticResource Dim}" Margin="6,0,2,0"/>
                <Button Content="all" FontSize="10.5" Command="{Binding PortEditor.AllTcpCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"/>
                <Button Content="none" FontSize="10.5" Command="{Binding PortEditor.NoTcpCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="UDP" Classes="settingLabel" FontSize="10.5"
                           Foreground="{StaticResource Dim}" Margin="6,0,2,0"/>
                <Button Content="all" FontSize="10.5" Command="{Binding PortEditor.AllUdpCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"/>
                <Button Content="none" FontSize="10.5" Command="{Binding PortEditor.NoUdpCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"/>
              </StackPanel>

              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                <Button Content="New port" FontSize="10.5" Command="{Binding PortEditor.AddCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"/>
                <Button Content="Delete" FontSize="10.5" Command="{Binding PortEditor.DeleteCommand}"
                        Background="White" BorderBrush="#E2B6B1" BorderThickness="1"
                        Foreground="{StaticResource Crit}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource Dim}">
                  <Run Text="{Binding PortEditor.TotalCount}" Foreground="#142326"/><Run Text=" ports"/>
                </TextBlock>
                <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource Dim}">
                  <Run Text="{Binding PortEditor.TcpCount}" Foreground="#0B7C8B"/><Run Text=" TCP"/>
                </TextBlock>
                <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource Dim}">
                  <Run Text="{Binding PortEditor.UdpCount}" Foreground="#5A4FCF"/><Run Text=" UDP"/>
                </TextBlock>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding PortEditor.Status}" FontSize="10"
                         Foreground="{StaticResource Dimmer}" HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <DataGrid ItemsSource="{Binding PortEditor.Visible}"
                    SelectedItem="{Binding PortEditor.Selected}"
                    AutoGenerateColumns="False" IsReadOnly="False"
                    CanUserResizeColumns="True" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="90"/>
              <DataGridCheckBoxColumn Header="TCP" Binding="{Binding Tcp}" Width="60"/>
              <DataGridCheckBoxColumn Header="UDP" Binding="{Binding Udp}" Width="60"/>
              <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- ========== Ansicht: Dienste ========== -->
        <DockPanel x:Name="view_Services" IsVisible="False" LastChildFill="True"
                   Background="{StaticResource Workspace}">

          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Width="220" Watermark="Search service, group or port"
                       Text="{Binding ServiceEditor.Filter}"/>

              <CheckBox Grid.Column="1" Content="only selected" FontSize="10.5"
                        VerticalAlignment="Center"
                        IsChecked="{Binding ServiceEditor.OnlySelected}"/>

              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button Content="Select all" FontSize="10.5"
                        Command="{Binding ServiceEditor.SelectAllCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"/>
                <Button Content="Select none" FontSize="10.5"
                        Command="{Binding ServiceEditor.SelectNoneCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource Dim}">
                  <Run Text="{Binding ServiceEditor.SelectedCount}" Foreground="#0B7C8B"/><Run Text=" of "/><Run Text="{Binding ServiceEditor.TotalCount}"/><Run Text=" services selected"/>
                </TextBlock>

                <!-- Leere Auswahl heisst "alle" - das gehoert gesagt -->
                <TextBlock FontSize="10.5" Foreground="{StaticResource Warn}"
                           IsVisible="{Binding ServiceEditor.ScansEverything}"
                           Text="Nothing selected - a scan then looks for every service."/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ServiceEditor.Status}" FontSize="10"
                         Foreground="{StaticResource Dimmer}" HorizontalAlignment="Right"
                         VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <DataGrid ItemsSource="{Binding ServiceEditor.Visible}"
                    SelectedItem="{Binding ServiceEditor.Selected}"
                    AutoGenerateColumns="False" IsReadOnly="False"
                    CanUserResizeColumns="True" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="SCAN" Binding="{Binding ToScan}" Width="60"/>
              <DataGridTextColumn Header="SERVICE" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
              <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="150" IsReadOnly="True"/>
              <DataGridTextColumn Header="PORTS" Binding="{Binding Ports}" Width="220"/>

              <!--
                  Das Erkennungspaket wird gezeigt, nicht bearbeitet. Es ist das
                  Herz der Diensterkennung - ein Byte daran geaendert, und ein
                  Dienst wird nicht mehr gefunden, ohne dass die Ursache
                  erkennbar waere.
              -->
              <DataGridTemplateColumn Header="DETECTION PACKET" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DetectionPacket}" Classes="mono" FontSize="10"
                               Foreground="{StaticResource Dimmer}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="Read-only: the probe used to recognise this service"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- ========== Ansicht: Satelliten ========== -->
        <!--
            Liste links, Maske rechts - dasselbe Muster wie bei den Bereichen.
            Adresse und Port fehlen absichtlich: der Satellit verbindet sich
            hierher, seine Herkunft ist Beobachtung und keine Einstellung.
            Siehe SATELLIT.md.
        -->
        <DockPanel x:Name="view_Satellites" IsVisible="False" LastChildFill="True"
                   Background="{StaticResource Workspace}">

          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10.5"
                         Foreground="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="620"
                         HorizontalAlignment="Left"
                         Text="A satellite is this application running as a service in another network segment. It connects to this machine on its own, announces its name and waits to be approved - there is nothing to type in here. Not in service yet: no satellite can connect, so this list stays empty and every range is scanned from here."/>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Approve" Command="{Binding SatelliteEditor.ApproveCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                        FontSize="10.5"/>
                <Button Content="Revoke" Command="{Binding SatelliteEditor.RevokeCommand}"
                        Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                        FontSize="10.5"/>
                <Button Content="Delete" Command="{Binding SatelliteEditor.DeleteCommand}"
                        Background="White" BorderBrush="#E2B6B1" BorderThickness="1"
                        Foreground="{StaticResource Crit}" FontSize="10.5"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding SatelliteEditor.Status}" FontSize="10"
                         Foreground="{StaticResource Dimmer}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding SatelliteEditor.LinkStatus}" FontSize="10"
                         Foreground="{StaticResource Teal}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Betrieb: horchen, Port, Firewall, eigener Satellitenbetrieb -->
          <ScrollViewer DockPanel.Dock="Right" Width="430" Padding="16,14"
                        Background="{StaticResource Workspace}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <StackPanel Spacing="14">

              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="LISTEN FOR SATELLITES" Classes="settingsHead"/>

                  <CheckBox Content="Accept satellite connections"
                            IsChecked="{Binding Settings.SatelliteListenEnabled}"/>

                  <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="Port" Classes="settingLabel"/>
                    <NumericUpDown Grid.Column="1" Width="130" HorizontalAlignment="Left"
                                   Minimum="1" Maximum="65535" Increment="1"
                                   FormatString="0"
                                   Value="{Binding Settings.SatelliteListenPort}"/>
                  </Grid>

                  <TextBlock Classes="settingHint"
                            Text="Satellites connect to this machine, so this port has to be reachable from the outside. Pick it freely - the list below only tells you where you would get through without a new firewall rule."/>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Own fingerprint" Classes="settingLabel"/>
                    <SelectableTextBlock Classes="mono" FontSize="9.5" TextWrapping="Wrap"
                                         Foreground="{StaticResource Dim}"
                                         Text="{Binding SatelliteEditor.OwnFingerprint}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="FIREWALL" Classes="settingsHead"/>

                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Refresh" Click="bt_FirewallRefresh_Click"
                            Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                            FontSize="10.5"/>
                    <Button Content="Open my port" Click="bt_FirewallAllow_Click"
                            IsEnabled="{Binding SatelliteEditor.CanCreateFirewallRule}"
                            Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                            FontSize="10.5"/>
                    <Button Content="Remove my rule" Click="bt_FirewallRemove_Click"
                            IsEnabled="{Binding SatelliteEditor.CanCreateFirewallRule}"
                            Background="White" BorderBrush="#E2B6B1" BorderThickness="1"
                            Foreground="{StaticResource Crit}" FontSize="10.5"/>
                  </StackPanel>

                  <TextBlock Text="{Binding SatelliteEditor.FirewallStatus}" Classes="settingHint"/>

                  <ListBox ItemsSource="{Binding SatelliteEditor.AllowedInboundPorts}"
                           MaxHeight="150" FontSize="10.5" Background="Transparent"
                           BorderBrush="{StaticResource Line}" BorderThickness="1"/>

                  <TextBlock Classes="settingHint"
                            Text="Without elevated rights only ports are listed that are open for any application - those are the ones you can use as they are. As administrator you also see the rest and may create your own rule, bound to this application alone."/>
                </StackPanel>
              </Border>

              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="RUN AS A SATELLITE" Classes="settingsHead"/>

                  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto"
                        ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Main scanner" Classes="settingLabel"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding Settings.MainScannerHost}"
                             Watermark="host name or address"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" Classes="settingLabel"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Width="130" HorizontalAlignment="Left"
                                   Minimum="1" Maximum="65535" Increment="1" FormatString="0"
                                   Value="{Binding Settings.MainScannerPort}"/>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Connect" Click="bt_SatelliteConnect_Click"
                            Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                            FontSize="10.5"/>
                    <Button Content="Disconnect" Click="bt_SatelliteDisconnect_Click"
                            Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                            FontSize="10.5"/>
                  </StackPanel>

                  <TextBlock Text="{Binding SatelliteEditor.ClientStatus}" Classes="settingHint"/>

                  <TextBlock Classes="settingHint"
                            Text="This machine then connects out to that main scanner and waits there to be approved. A host name is better than an address: it survives the main scanner changing its IP."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid ColumnDefinitions="380,1,*">

            <DataGrid Grid.Column="0" ItemsSource="{Binding SatelliteEditor.All}"
                      SelectedItem="{Binding SatelliteEditor.Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserResizeColumns="True" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SATELLITE" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="STATE" Binding="{Binding StatusText}" Width="Auto" MinWidth="120"/>
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Background="{StaticResource Line}"/>

            <ScrollViewer Grid.Column="2" Padding="18"
                          IsVisible="{Binding SatelliteEditor.Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="14" MaxWidth="520" HorizontalAlignment="Left">

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="16,14">
                  <StackPanel Spacing="11">
                    <TextBlock Text="SATELLITE" Classes="settingsHead"/>

                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="10" RowSpacing="8">
                      <!--
                          Der Name kommt vom Satelliten selbst und ist darum
                          Anzeige, kein Eingabefeld: haende man ihn hier
                          um, zeigte er beim naechsten Verbinden wieder seinen
                          eigenen, und die Bereiche zeigten ins Leere.
                      -->
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Classes="settingLabel"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                 FontSize="12" FontWeight="SemiBold"
                                 Text="{Binding SatelliteEditor.Selected.Name}"/>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Note" Classes="settingLabel"/>
                      <TextBox Grid.Row="1" Grid.Column="1"
                               Text="{Binding SatelliteEditor.Selected.Note}"
                               Watermark="where it stands, what it covers"/>
                    </Grid>

                    <TextBlock Classes="settingHint"
                               Text="The satellite reports its own name when it connects - that is the name a range points at under &quot;Scanned by&quot;. Only the note is yours to fill in."/>
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="4" Padding="16,14">
                  <StackPanel Spacing="11">
                    <TextBlock Text="IDENTITY" Classes="settingsHead"/>

                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="10" RowSpacing="6">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="State" Classes="settingLabel"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                 FontSize="11" Text="{Binding SatelliteEditor.Selected.StatusText}"/>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Fingerprint" Classes="settingLabel"/>
                      <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="10"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{Binding SatelliteEditor.Selected.Fingerprint}"/>

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Last seen" Classes="settingLabel"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                 Text="{Binding SatelliteEditor.Selected.LastSeen}"/>

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Version" Classes="settingLabel"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                 Text="{Binding SatelliteEditor.Selected.Version}"/>

                      <TextBlock Grid.Row="4" Grid.Column="0" Text="Last address" Classes="settingLabel"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                 Classes="mono"
                                 Text="{Binding SatelliteEditor.Selected.RemoteAddress}"/>
                    </Grid>

                    <TextBlock Classes="settingHint"
                               Text="A satellite identifies itself by the fingerprint of its key, not by its address - so it may move or change IP without losing its approval. These values are filled in by the satellite itself the first time it connects."/>

                    <Border Background="#F2EDDF" CornerRadius="3" Padding="9,6"
                            IsVisible="{Binding SatelliteEditor.Selected.NeedsApproval}">
                      <TextBlock FontSize="10.5" TextWrapping="Wrap"
                                 Foreground="{StaticResource Warn}"
                                 Text="This satellite has announced itself but is not approved. It gets no jobs until you approve it."/>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>

        <!-- ========== Ansicht: Einstellungen ========== -->
        <!--
            Zwei Spalten statt der frueheren Streuung ueber sechs Reiter. Was
            den Scan betrifft, steht links; was Ablage und Umgebung betrifft,
            rechts. Jede Einstellung traegt einen Satz, der sagt, was sie
            bewirkt - ein Schieberegler namens "TimeOut" allein sagt niemandem,
            ob gross oder klein besser ist.

            Jede Aenderung wird sofort gespeichert; es gibt bewusst keinen
            Speichern-Knopf, den man vergessen kann.
        -->
        <ScrollViewer x:Name="view_Settings" IsVisible="False"
                      Background="{StaticResource Workspace}" Padding="18">
          <Grid ColumnDefinitions="*,18,*" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel Grid.Column="0" Spacing="14">

              <!-- Scan -->
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="14">
                  <TextBlock Text="SCAN" Classes="settingsHead"/>

                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="Port timeout" Classes="settingLabel"/>
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                 Foreground="{StaticResource Teal}" VerticalAlignment="Center">
                        <Run Text="{Binding Settings.PortTimeoutMs}"/><Run Text=" ms"/>
                      </TextBlock>
                    </Grid>
                    <Slider x:Name="sl_Timeout" Minimum="10" Maximum="3000"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            SmallChange="10" LargeChange="100" MaxWidth="460"
                            HorizontalAlignment="Stretch"
                            Value="{Binding Settings.PortTimeoutMs, Mode=TwoWay}"/>
                    <TextBlock Classes="settingHint"
                               Text="How long a single port may take to answer. Low values scan faster but miss slow or distant devices; high values are thorough but drag out a run over many targets."/>
                  </StackPanel>

                  <StackPanel Spacing="3">
                    <CheckBox Content="Scan all 65,536 TCP ports"
                              IsChecked="{Binding Settings.ScanAllPorts}"/>
                    <TextBlock Classes="settingHint"
                               Text="Ignores the port collection and tries every port. Finds services on unusual ports - and takes hours instead of minutes."/>
                  </StackPanel>

                  <!-- Ohne die richtige Kennung bleibt die Switchport-Abfrage
                       ohne Ergebnis, und zwar stumm - darum steht der Hinweis
                       darunter und nicht in einer Fehlermeldung. -->
                  <StackPanel Spacing="3">
                    <TextBlock Text="SNMP community" Classes="settingLabel"/>
                    <TextBox Text="{Binding Settings.SnmpCommunity, Mode=TwoWay}"
                             MaxWidth="240" HorizontalAlignment="Left"/>
                    <TextBlock Classes="settingHint"
                               Text="The read password for switches and managed devices. Needed by &quot;Switch port and VLAN&quot; to ask which device hangs on which port. Factory default is &quot;public&quot;; where that has been changed, the query stays empty."/>
                  </StackPanel>

                  <!-- Je Verfahren einzeln, nicht fuer den ganzen Lauf: Ping,
                       ARP und SNMP sollen den Bereich abklopfen, Port- und
                       Dienstscan danach nur noch, was geantwortet hat. -->
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                          CornerRadius="4" Padding="12,10">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Scan only devices in table" FontWeight="SemiBold" FontSize="11.5"/>
                      <TextBlock Classes="settingHint"
                                 Text="Per method. A ticked method only asks the devices found so far - the others still sweep the whole range. Methods that listen instead of asking (SSDP, mDNS, ARP table) have no target list and are not listed."/>

                      <CheckBox Content="All methods" FontSize="11"
                                ToolTip.Tip="Overrides the individual boxes below"
                                IsChecked="{Binding Settings.OnlyKnownTargets}"/>

                      <StackPanel Margin="12,2,0,0">
                        <ItemsControl ItemsSource="{Binding RestrictableMethods}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScanMethodChoice">
                              <CheckBox Content="{Binding DisplayName}" FontSize="11"
                                        MinHeight="22" Margin="0,0,0,1"
                                        IsChecked="{Binding OnlyKnownTargets}"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Kein Verfahren, sondern die Unterfunktion des
                             Namensscans - steht aber hier, weil sie dieselbe
                             Frage beantwortet und dieselbe Zeit spart. -->
                        <CheckBox Content="DNS cross-check" FontSize="11"
                                  MinHeight="22" Margin="0,0,0,1"
                                  IsChecked="{Binding Settings.CrossCheckOnlyKnownTargets}"
                                  ToolTip.Tip="Compares only the devices that answered in this run. Off, it also checks every old row in the table - which is how you find names that still resolve although the device is long gone."/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- Gruppenrahmen mit Schalter auf der Rahmenlinie.
                       Das Kaestchen behaelt seine natuerliche Hoehe - eine
                       feste Hoehe schneidet es unten ab, weil Fluent
                       Kaestchen und Beschriftung darin zentriert. Statt
                       dessen faengt der Rahmen auf halber Kaestchenhoehe an,
                       dann liegt die Linie durch beides hindurch. -->
                  <Grid Margin="0,4,0,0">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="4" Padding="12,24,12,10" Margin="0,16,0,0">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="settingHint"
                                   Text="Ticked services are folded into the &quot;+n&quot; badge in the Running services column; everything else is listed by name. With the switch off, every service is listed - which is the point of the column."/>

                        <!-- Der Roller darf nicht mit abgeschaltet werden:
                             sonst laesst sich bei ausgeschaltetem Schalter
                             nicht einmal nachsehen, was ausgewaehlt ist. -->
                        <!-- Zwei Spalten, die jede fuer sich untereinander
                             wachsen. Ein Gitter mit gleich hohen Zellen
                             richtet sich an der groessten Rubrik aus und
                             reisst zwischen den kleinen Luecken auf. -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled">
                          <Grid ColumnDefinitions="*,*">
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding GroupableServicesLeft}"
                                          Margin="0,0,10,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupableServiceGroup">
                                  <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Dim}"
                                               Margin="0,0,0,1"/>
                                    <ItemsControl ItemsSource="{Binding Services}" Margin="14,0,0,0">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GroupableService">
                                          <CheckBox Content="{Binding Name}" FontSize="11"
                                                    MinHeight="0" Padding="7,0,0,0" Margin="0,1"
                                                    IsChecked="{Binding IsGrouped}"/>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding GroupableServicesRight}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupableServiceGroup">
                                  <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Dim}"
                                               Margin="0,0,0,1"/>
                                    <ItemsControl ItemsSource="{Binding Services}" Margin="14,0,0,0">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GroupableService">
                                          <CheckBox Content="{Binding Name}" FontSize="11"
                                                    MinHeight="0" Padding="7,0,0,0" Margin="0,1"
                                                    IsChecked="{Binding IsGrouped}"/>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Grid>
                        </ScrollViewer>
                      </StackPanel>
                    </Border>

                    <!-- MinHeight 0 nimmt Fluent die eingebauten 32 Pixel;
                         die Hoehe ergibt sich dann aus Kaestchen und Schrift,
                         die darin ohnehin zueinander mittig stehen. -->
                    <CheckBox Content="Group services" FontWeight="SemiBold" FontSize="11.5"
                              VerticalAlignment="Top" HorizontalAlignment="Left"
                              MinHeight="0" Margin="10,0,0,0" Padding="7,0,8,0"
                              Background="{StaticResource Panel}"
                              IsChecked="{Binding GroupServices}"/>
                  </Grid>

                  <StackPanel Spacing="3">
                    <CheckBox Content="Keep the last scan result"
                              IsChecked="{Binding SaveLastScanResult}"/>
                    <TextBlock Classes="settingHint"
                               Text="Writes the devices to disk when the window closes and loads them again at the next start. Nothing counts as reachable until it has answered again."/>
                  </StackPanel>

                  <StackPanel Spacing="3">
                    <CheckBox Content="Clear the ARP cache before scanning"
                              IsChecked="{Binding Settings.ClearArpCacheFirst}"/>
                    <TextBlock Classes="settingHint"
                               Text="Forces every MAC address to be resolved again instead of taken from the cache. Needs elevated rights; without them the scan simply keeps the cached entries."/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- MAC-Herstellerliste -->
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="MAC VENDOR DATABASE" Classes="settingsHead"/>

                  <StackPanel Spacing="5">
                    <!--
                        Keine eigene Hoehe/Polsterung: der Button-Stil setzt
                        Height 22, und ein groesseres Padding liess die
                        Beschriftung unten abschneiden.
                    -->
                    <Button Content="Update from Wireshark" HorizontalAlignment="Left"
                            Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                            Command="{Binding UpdateMacVendorsCommand}"
                            IsEnabled="{Binding !IsUpdatingMacVendors}"/>
                    <TextBlock Classes="settingHint"
                               Text="The bundled list only covers the classic 24-bit vendor blocks (MA-L). Wireshark's manuf file adds the newer 28- and 36-bit blocks (MA-M, MA-S) that many smaller and IoT manufacturers use today, so more devices get a real vendor name instead of &quot;Unknown&quot;. Needs internet access; takes effect on the next scan."/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Namensaufloesung -->
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="NAME RESOLUTION" Classes="settingsHead"/>

                  <StackPanel Spacing="5">
                    <TextBlock Text="DNS server override" Classes="settingLabel"/>
                    <TextBox Width="230" HorizontalAlignment="Left" Watermark="e.g. 10.0.0.1"
                             Text="{Binding Settings.OverrideDnsServer}"/>
                    <TextBlock Classes="settingHint"
                               Text="Overrides the DNS servers stored on each range, for every range at once. Leave empty to use what each range defines."/>
                  </StackPanel>

                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="Reverse lookups at once" Classes="settingLabel"/>
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="11"
                                 Foreground="{StaticResource Teal}" VerticalAlignment="Center"
                                 Text="{Binding Settings.ReverseLookupConcurrency}"/>
                    </Grid>
                    <Slider x:Name="sl_ReverseLookupConcurrency" Minimum="1" Maximum="64"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="8" MaxWidth="460"
                            HorizontalAlignment="Stretch"
                            Value="{Binding Settings.ReverseLookupConcurrency, Mode=TwoWay}"/>
                    <TextBlock Classes="settingHint"
                               Text="How many addresses the reverse lookup asks for at the same time. A company name server handles 32 or 64 without trouble and finishes a large range in a fraction of the time. A home router does not: under a burst it silently drops most requests and devices that do have a name come back as unknown. Raise it only where a real name server answers - if results start going missing, go back down."/>
                  </StackPanel>

                  <!-- Der Quervergleich der DNS-Server steht bewusst nicht
                       hier, sondern als Unterfunktion beim Namensscan in der
                       Verfahren-Schublade: er ist Teil des Laufs und keine
                       Grundeinstellung, und man entscheidet ihn dort, wo man
                       auch die Verfahren anhakt. -->
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="14">

              <!-- Ablage -->
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="12">
                  <TextBlock Text="STORAGE" Classes="settingsHead"/>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Settings folder" Classes="settingLabel"/>
                    <TextBlock Text="{Binding SettingsFolder}" Classes="mono" FontSize="10"
                               Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
                    <Button x:Name="bt_OpenSettingsFolder" Content="Open folder"
                            HorizontalAlignment="Left" Margin="0,3,0,0"
                            Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                            Click="bt_OpenSettingsFolder_Click"/>
                    <TextBlock Classes="settingHint"
                               Text="Holds the ranges, the port collection, the service definitions and these settings - one file each, all plain text."/>
                  </StackPanel>

                  <Border Height="1" Background="{StaticResource LineSoft}"/>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Application folder" Classes="settingLabel"/>
                    <TextBlock Text="{Binding ApplicationFolder}" Classes="mono" FontSize="10"
                               Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
                    <Button x:Name="bt_OpenAppFolder" Content="Open folder"
                            HorizontalAlignment="Left" Margin="0,3,0,0"
                            Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                            Click="bt_OpenAppFolder_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Was hier noch nicht steht -->
              <Border Background="#F4F8F8" BorderBrush="{StaticResource Line}"
                      BorderThickness="1" CornerRadius="4" Padding="16,14">
                <StackPanel Spacing="7">
                  <TextBlock Text="NOT HERE YET" Classes="settingsHead"/>
                  <TextBlock Classes="settingHint"
                             Text="Ports, service definitions and hostname mapping have their own pages in the rail - they are lists, not switches, and are still being moved over."/>
                  <TextBlock Classes="settingHint"
                             Text="Saving the last scan result and the topology renderer option follow once those parts exist in this window; a switch that does nothing would be worse than none."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- ========== Netz: die Adapter dieses Rechners ========== -->
        <DockPanel x:Name="view_Network" IsVisible="False" LastChildFill="True"
                   Background="{StaticResource Workspace}">

          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                  Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Text="ADAPTERS ON THIS MACHINE" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
              <CheckBox Content="include disabled" FontSize="10.5"
                        IsChecked="{Binding NetworkView.IncludeDown}"/>
              <Button Content="Refresh" FontSize="10.5" Background="White"
                      BorderBrush="#C3D2D4" BorderThickness="1"
                      Command="{Binding NetworkView.RefreshCommand}"/>
            </StackPanel>
          </Border>

          <!-- Der Hinweis steht unter der Liste, nicht darueber: er ergibt
               sich aus ihr und soll die Tabelle nicht wegdruecken. -->
          <Border DockPanel.Dock="Bottom" Padding="12,8"
                  Background="{StaticResource CritSoft}"
                  IsVisible="{Binding NetworkView.HasDnsWarning}">
            <TextBlock Text="{Binding NetworkView.DnsWarningText}" FontSize="11"
                       Foreground="{StaticResource Crit}" TextWrapping="Wrap"/>
          </Border>

          <DataGrid ItemsSource="{Binding NetworkView.Adapters}"
                    SelectedItem="{Binding NetworkView.Selected}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserResizeColumns="True" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ADAPTER" Binding="{Binding Name}" Width="Auto" MinWidth="130"/>
              <DataGridTextColumn Header="STATE" Binding="{Binding ConfigurationText}" Width="Auto" MinWidth="60"/>

              <!-- Die Zahl steht vor der Aufzaehlung, damit ein Ausreisser
                   auffaellt, ohne dass man 25 Adressen lesen muss. -->
              <DataGridTemplateColumn Header="DNS" Width="Auto" MinWidth="50">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="net:AdapterInfo">
                    <TextBlock Text="{Binding DnsServerCount}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{Binding DnsServerCount, Converter={StaticResource DnsCountBrush}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="DNS SERVERS" Binding="{Binding DnsText}" Width="*"/>
              <DataGridTextColumn Header="IPV4" Binding="{Binding Ipv4Text}" Width="Auto" MinWidth="110"/>
              <DataGridTextColumn Header="GATEWAY" Binding="{Binding GatewayText}" Width="Auto" MinWidth="110"/>
              <DataGridTextColumn Header="SUFFIX" Binding="{Binding DnsSuffix}" Width="Auto" MinWidth="90"/>
              <DataGridTextColumn Header="MAC" Binding="{Binding MacText}" Width="Auto" MinWidth="130"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- ========== Befunde ========== -->
        <DockPanel x:Name="view_Findings" IsVisible="False" LastChildFill="True"
                   Background="{StaticResource Workspace}">

          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                  Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Text="FINDINGS" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>

              <!-- Die Zaehler stehen vorn: wie viele und wie schlimm ist die
                   erste Frage, die Liste beantwortet erst die zweite. -->
              <Border Background="{StaticResource CritSoft}" CornerRadius="3" Padding="6,1">
                <TextBlock FontSize="10.5" Foreground="{StaticResource Crit}">
                  <Run Text="{Binding FindingsView.CriticalCount}"/><Run Text=" critical"/>
                </TextBlock>
              </Border>
              <Border Background="#FAEBD3" CornerRadius="3" Padding="6,1">
                <TextBlock FontSize="10.5" Foreground="{StaticResource Warn}">
                  <Run Text="{Binding FindingsView.WarningCount}"/><Run Text=" warnings"/>
                </TextBlock>
              </Border>
              <Border Background="{StaticResource LineSoft}" CornerRadius="3" Padding="6,1">
                <TextBlock FontSize="10.5" Foreground="{StaticResource Dim}">
                  <Run Text="{Binding FindingsView.NoteCount}"/><Run Text=" notes"/>
                </TextBlock>
              </Border>

              <CheckBox Content="critical only" FontSize="10.5"
                        IsChecked="{Binding FindingsView.CriticalOnly}"/>

              <Button Content="Re-check" FontSize="10.5" Background="White"
                      BorderBrush="#C3D2D4" BorderThickness="1"
                      Command="{Binding FindingsView.RefreshCommand}"/>
            </StackPanel>
          </Border>

          <TextBlock DockPanel.Dock="Top" Margin="16,20" FontSize="11.5"
                     Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                     Text="{Binding FindingsView.EmptyText}"
                     IsVisible="{Binding !FindingsView.HasFindings}"/>

          <DataGrid ItemsSource="{Binding FindingsView.Findings}"
                    SelectedItem="{Binding FindingsView.Selected}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserResizeColumns="True" SelectionMode="Single"
                    IsVisible="{Binding FindingsView.HasFindings}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="Auto" MinWidth="72">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:Finding">
                    <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                            Background="{Binding Severity, Converter={StaticResource SeverityBg}}">
                      <TextBlock Text="{Binding SeverityText}" FontSize="9" FontWeight="SemiBold"
                                 Foreground="{Binding Severity, Converter={StaticResource SeverityFg}}"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Adressfamilie in der Farbe des Entwurfs. Heute fast immer
                   leer; sobald die IPv6-Regeln stehen, ist an dieser Spalte
                   auf einen Blick zu sehen, was davon v6 betrifft. -->
              <DataGridTemplateColumn Header="" Width="Auto" MinWidth="30">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:Finding">
                    <TextBlock Text="{Binding FamilyText}" FontSize="9.5" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{Binding Family, Converter={StaticResource FamilyBrush}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTextColumn Header="AREA" Binding="{Binding CategoryText}"
                                  Width="Auto" MinWidth="100"/>
              <DataGridTextColumn Header="FINDING" Binding="{Binding Title}"
                                  Width="Auto" MinWidth="200"/>
              <DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}"
                                  Width="Auto" MinWidth="140"/>
              <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>

        <!-- ========== Topologie ========== -->
        <DockPanel x:Name="view_Topology" IsVisible="False" LastChildFill="True"
                   Background="{StaticResource Workspace}">

          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                  Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Text="TOPOLOGY" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
              <Button x:Name="bt_DrawTopology" Content="Draw" FontSize="10.5"
                      Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                      Click="bt_DrawTopology_Click"/>
              <RadioButton x:Name="rb_TopologyNetwork" GroupName="TopologyMode" Content="Network topo"
                           FontSize="10.5" IsChecked="True"
                           ToolTip.Tip="Devices grouped by network - duplicate addresses and names show up as coloured edges"/>
              <RadioButton x:Name="rb_TopologyService" GroupName="TopologyMode" Content="Service topo"
                           FontSize="10.5"
                           ToolTip.Tip="Devices grouped by service - only devices that actually run a service are drawn"/>
              <CheckBox Content="library from CDN" FontSize="10.5"
                        ToolTip.Tip="Load the 3D library from the internet - the generated page can then be passed on by itself"
                        IsChecked="{Binding Settings.UseOnlineTopologyLibrary}"/>
              <TextBlock x:Name="tb_TopologyHint" FontSize="10.5" VerticalAlignment="Center"
                         Foreground="{StaticResource Dim}"
                         Text="Duplicate addresses and names are drawn as coloured edges."/>
            </StackPanel>
          </Border>

          <!--
              Die Webansicht wird bewusst im Code eingehaengt, nicht hier.
              NativeWebView setzt unter Linux auf WPE WebKit auf; fehlt das,
              reisst schon das Erzeugen des Controls den Prozess mit. Was hier
              steht, entsteht aber beim Laden des XAML - also bevor irgendetwas
              geprueft werden koennte. Siehe PrepareTopologyView.
          -->
          <Panel x:Name="host_Topology"/>
        </DockPanel>

        <!-- ========== Noch nicht gebaute Ansichten ========== -->
        <Border x:Name="view_Placeholder" IsVisible="False"
                Background="{StaticResource Workspace}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock x:Name="tb_PlaceholderTitle" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="tb_PlaceholderText" FontSize="11.5" Foreground="{StaticResource Dimmer}"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                       TextWrapping="Wrap"/>

            <!-- Solange eine Ansicht hier fehlt, gibt es sie im bisherigen
                 Fenster noch - ein Klick statt eines Neustarts. -->
            <Button x:Name="bt_OpenClassic" Content="Open in the previous window"
                    HorizontalAlignment="Center" Margin="0,10,0,0"
                    Background="White" BorderBrush="#C3D2D4" BorderThickness="1"
                    Click="bt_OpenClassic_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
