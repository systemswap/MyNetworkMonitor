<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyNetworkMonitor.Avalonia.Views.VisualizeTopologieView"
        x:CompileBindings="False"
        Title="Visualize DNS Topology" Height="800" Width="1600">

    <!--
        Portierung von VisualizeTopologieWindow.xaml (WPF). Statt WebView2 haelt
        das Fenster hier Avalonias NativeWebView (Windows: WebView2,
        Linux: WebKitGTK). Die Seite selbst kommt unveraendert aus
        MyNetworkMonitor.Core (TopologyGraph / TopologyWebServer).
    -->
    <Grid>
        <NativeWebView x:Name="webView"/>
    </Grid>
</Window>
