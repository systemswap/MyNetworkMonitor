<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyNetworkMonitor.Core.ViewModels;assembly=MyNetworkMonitor.Core"
        x:Class="MyNetworkMonitor.Avalonia.Views.ManageIPGroupsView"
        x:DataType="vm:ManageIPGroupsViewModel"
        Title="Manage IP Groups" Width="1200" Height="600">

    <!--
        Avalonia-View für die IP-Gruppen-Verwaltung. Bindet an dasselbe
        plattformneutrale ManageIPGroupsViewModel (MyNetworkMonitor.Core) wie die
        WPF-View. Kein Logik-Code-behind – nur Bindings und Commands.
    -->
    <DockPanel Margin="10">

        <!-- Eingabemaske oben -->
        <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10"
                BorderBrush="#3F000000" BorderThickness="1" CornerRadius="6">
            <StackPanel Spacing="8">
                <WrapPanel>
                    <CheckBox Content="is active" IsChecked="{Binding EditIsActive}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Group Description"/>
                        <TextBox Width="180" Text="{Binding EditIpGroupDescription}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Device Description"/>
                        <TextBox Width="180" Text="{Binding EditDeviceDescription}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="First IP / Hostname"/>
                        <TextBox Width="130" Text="{Binding EditFirstIP}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Last IP"/>
                        <TextBox Width="130" Text="{Binding EditLastIP}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Domain"/>
                        <TextBox Width="110" Text="{Binding EditDomain}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="DNS Servers"/>
                        <TextBox Width="180" Text="{Binding EditDnsServers}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="NM Gateway IP"/>
                        <TextBox Width="140" Text="{Binding EditNmGatewayIP}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Gateway Port"/>
                        <TextBox Width="90" Text="{Binding EditNmGatewayPort}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Scan Interval (min)"/>
                        <TextBox Width="110" Text="{Binding EditScanIntervalMinutes}"/>
                    </StackPanel>
                    <CheckBox Content="auto scan" IsChecked="{Binding EditAutomaticScan}" VerticalAlignment="Center"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Add entry" Command="{Binding AddEntryCommand}"/>
                    <Button Content="Edit entry" Command="{Binding EditRowCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Aktionen unten -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="Delete entry" Command="{Binding DeleteEntryCommand}"/>
            <Button Content="Save Changes" Command="{Binding SaveChangesCommand}"/>
        </StackPanel>

        <!-- Datengitter -->
        <DataGrid ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedGroup}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="All"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="active" Binding="{Binding IsActive}"/>
                <DataGridTextColumn Header="Group Description" Binding="{Binding IpGroupDescription}" Width="180"/>
                <DataGridTextColumn Header="Device Description" Binding="{Binding DeviceDescription}" Width="180"/>
                <DataGridTextColumn Header="First IP" Binding="{Binding FirstIP}" Width="130"/>
                <DataGridTextColumn Header="Last IP" Binding="{Binding LastIP}" Width="130"/>
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="110"/>
                <DataGridTextColumn Header="DNS Servers" Binding="{Binding DnsServers}" Width="160"/>
                <DataGridTextColumn Header="NM Gateway IP" Binding="{Binding NmGatewayIP}" Width="140"/>
                <DataGridTextColumn Header="Gateway Port" Binding="{Binding NmGatewayPort}" Width="100"/>
                <DataGridCheckBoxColumn Header="auto" Binding="{Binding AutomaticScan}"/>
                <DataGridTextColumn Header="Interval (min)" Binding="{Binding ScanIntervalMinutes}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
